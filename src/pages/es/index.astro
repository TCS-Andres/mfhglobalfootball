---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';

const lang = 'es';
const title = 'MFH Global Football Agency | Agencia de Fútbol con Licencia FIFA';
const description =
  'MFH Global Football Agency es una agencia con licencia FIFA que guía a jugadores y familias al fútbol profesional en el Sur de la Florida, Colombia y Europa.';
---

<BaseLayout lang={lang} title={title} description={description}>
  <Home lang={lang} />
</BaseLayout>
