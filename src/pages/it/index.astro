---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';

const lang = 'it';
const title = 'MFH Global Football Agency | Agenzia di Calcio con Licenza FIFA';
const description =
  "MFH Global Football Agency è un'agenzia con licenza FIFA che guida giocatori e famiglie verso il calcio professionistico tra Florida del Sud, Colombia ed Europa.";
---

<BaseLayout lang={lang} title={title} description={description}>
  <Home lang={lang} />
</BaseLayout>
