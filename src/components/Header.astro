---
import { t, localizePath, type Lang } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Nav order: About first, then Services, then How It Works, Resources, Contact.
// Services is a mega menu (Overview, Player Representation, Coach Representation);
// Player Representation opens a nested flyout of the player-side services.
const about = [
  { href: '/about', key: 'nav.about' },
  { href: '/bert-mahecha', key: 'nav.journey' },
  { href: '/team', key: 'nav.staff' },
];
// Nested flyout under "Player Representation" (the player-side services).
const playerSub = [
  { href: '/services/youth-family-advisory', key: 'sv.youth.name' },
  { href: '/services/transfers', key: 'sv.transfers.name' },
  { href: '/services/player-evaluation', key: 'sv.eval.name' },
];
// "Resources" dropdown (renamed from "Learn"). The /resources landing page holds
// the external tool links; Insights (blog) stays a child item here.
const learn = [
  { href: '/resources', key: 'nav.restools' },
  { href: '/how-to-choose-an-agent', key: 'nav.hca' },
  { href: '/faq', key: 'nav.faq' },
  { href: '/insights', key: 'nav.insights' },
];
const caret =
  '<svg class="nav-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
const caretRight =
  '<svg class="nav-caret-r" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';
---

<header class="site" id="top">
  <div class="wrap nav">
    <a class="brand" href={localizePath('/', lang)} aria-label="MFH Global Football Agency home">
      <img src="/logos/header.png" alt="MFH Global Football Agency" width="120" height="42" />
    </a>
    <nav class="nav-links" id="navlinks" aria-label="Main">
      <div class="nav-group" data-nav-group>
        <button class="nav-trigger" aria-expanded="false" aria-haspopup="true">
          <span>{t(lang, 'nav.about')}</span><Fragment set:html={caret} />
        </button>
        <div class="nav-menu">
          {about.map((i) => <a href={localizePath(i.href, lang)}>{t(lang, i.key)}</a>)}
        </div>
      </div>

      <div class="nav-group" data-nav-group>
        <button class="nav-trigger" aria-expanded="false" aria-haspopup="true">
          <span>{t(lang, 'nav.services')}</span><Fragment set:html={caret} />
        </button>
        <div class="nav-menu">
          <a href={localizePath('/services', lang)}>{t(lang, 'nav.overview')}</a>
          <div class="nav-sub" data-nav-sub>
            <a class="nav-sub__link" href={localizePath('/services/player-representation', lang)}>
              <span>{t(lang, 'sv.player.name')}</span><Fragment set:html={caretRight} />
            </a>
            <div class="nav-submenu">
              {playerSub.map((i) => <a href={localizePath(i.href, lang)}>{t(lang, i.key)}</a>)}
            </div>
          </div>
          <a href={localizePath('/services/coach-representation', lang)}>{t(lang, 'sv.coach.name')}</a>
        </div>
      </div>

      <a class="nav-solo" href={localizePath('/the-mfh-plan', lang)}>{t(lang, 'nav.plan')}</a>

      <div class="nav-group" data-nav-group>
        <button class="nav-trigger" aria-expanded="false" aria-haspopup="true">
          <span>{t(lang, 'nav.learn')}</span><Fragment set:html={caret} />
        </button>
        <div class="nav-menu">
          {learn.map((i) => <a href={localizePath(i.href, lang)}>{t(lang, i.key)}</a>)}
        </div>
      </div>

      <a class="nav-solo" href={localizePath('/contact', lang)}>{t(lang, 'nav.contact')}</a>
    </nav>
    <div class="nav-right">
      <LangSwitch lang={lang} />
      <a href={localizePath('/questionnaire', lang)} class="btn btn-outline">{t(lang, 'cta.qshort')}</a>
      <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="navlinks">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Sticky header shadow on scroll
  const header = document.querySelector('header.site');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }

  // Mobile menu toggle
  const burger = document.getElementById('burger');
  const links = document.getElementById('navlinks');
  if (burger && links) {
    burger.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    // Navigating (an actual link, not a dropdown trigger) closes the mobile menu
    links.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        links.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
      })
    );
  }

  // Dropdown groups: hover on desktop, click/tap everywhere, Escape and outside-click close.
  const groups = Array.from(document.querySelectorAll('[data-nav-group]'));
  const hoverDesktop = () => matchMedia('(hover: hover) and (min-width: 1025px)').matches;
  const closeGroups = (except) =>
    groups.forEach((g) => {
      if (g !== except) {
        g.classList.remove('is-open');
        g.querySelector('.nav-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  groups.forEach((g) => {
    const btn = g.querySelector('.nav-trigger');
    btn?.addEventListener('click', () => {
      const open = !g.classList.contains('is-open');
      closeGroups(g);
      g.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    g.addEventListener('mouseenter', () => {
      if (!hoverDesktop()) return;
      closeGroups(g);
      g.classList.add('is-open');
      btn?.setAttribute('aria-expanded', 'true');
    });
    g.addEventListener('mouseleave', () => {
      if (!hoverDesktop()) return;
      g.classList.remove('is-open');
      btn?.setAttribute('aria-expanded', 'false');
    });
    // Close when keyboard focus leaves the group
    g.addEventListener('focusout', (e) => {
      if (!g.contains(e.relatedTarget)) {
        g.classList.remove('is-open');
        btn?.setAttribute('aria-expanded', 'false');
      }
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('[data-nav-group]')) closeGroups();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeGroups();
  });
</script>
