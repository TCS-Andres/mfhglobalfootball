---
import { t, localizePath, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';
import TeamShowcase, { type TeamGroup } from '../react/TeamShowcase';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Bert leads the page in a featured founder section; the divisions follow in the
// TeamShowcase island (a 21st.dev component, see src/components/react).
// Members without a headshot get an initials tile until photos arrive.
//
// NEEDS INPUT (spec 3.2): Miguel Benito (st.p9) uses the initials placeholder
// until Bert supplies a headshot. Provisional division: Football Operations &
// Scouting, since his analytics/evaluation role maps to the Player Profile and
// Evaluation stages.
// A member gets an expandable `blurb` only when they have approved copy: Ezzy
// (p2), Andres (p5), and Fabian (p6). Sebastian, John, Maria, Miguel, Andres
// Hernandez, and Alejandro have none yet, so they render name + title only. Carlos expands to
// his fuller independent-partner bio, and his disclaimer `note` is always visible.
const divisions = [
  { key: 'st.div2', people: [{ key: 'st.p2', photo: '/photos/ezzy.jpg', blurb: true }, { key: 'st.p3', photo: '/photos/sebastian.jpg' }, { key: 'st.p4', photo: '/photos/john.jpg' }, { key: 'st.p10', photo: '/photos/andres-hernandez.jpg' }, { key: 'st.p11', photo: '/photos/alejandro.jpg' }, { key: 'st.p9' }] },
  { key: 'st.div3', people: [{ key: 'st.p5', photo: '/photos/andres.jpg', blurb: true }] },
  { key: 'st.div4', people: [{ key: 'st.p6', photo: '/photos/fabian.webp', blurb: true }] },
  { key: 'st.div5', people: [{ key: 'st.p7' }] },
  // Carlos is an independent partner (BM Accountax LLC); bio + disclaimer per his official one-pager.
  { key: 'st.div6', people: [{ key: 'st.p8', photo: '/photos/carlos.jpg', bio: true, note: true }] },
];

const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Resolve every string here so the island receives plain, already-translated data.
const groups: TeamGroup[] = divisions.map((d) => ({
  id: d.key,
  label: t(lang, d.key),
  members: d.people.map((person) => {
    const name = t(lang, `${person.key}.n`);
    return {
      id: person.key.replace('st.', ''),
      name,
      role: t(lang, `${person.key}.t`),
      initials: initials(name),
      image: 'photo' in person ? person.photo : undefined,
      blurb:
        'blurb' in person && person.blurb
          ? t(lang, `${person.key}.blurb`)
          : 'bio' in person && person.bio
            ? t(lang, `${person.key}.bio`)
            : undefined,
      note: 'note' in person && person.note ? t(lang, `${person.key}.note`) : undefined,
    };
  }),
}));

// Founder structured data for search engines.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bert Mahecha',
  jobTitle: 'Founder & FIFA-Licensed Football Agent',
  image: 'https://mfhglobal.football/photos/bert.jpg',
  sameAs: ['https://www.linkedin.com/in/berts'],
  worksFor: {
    '@type': 'SportsOrganization',
    name: 'MFH Global Football Agency',
    url: 'https://mfhglobal.football',
  },
  knowsLanguage: ['en', 'es'],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', name: 'FIFA Football Agent License (2026)' },
    { '@type': 'EducationalOccupationalCredential', name: 'US Soccer National C Coaching License' },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />

<section class="page-hero">
  <img class="page-hero__bg" src="/photos/team-hero.jpg" alt="" width="1600" height="686" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'st.eyebrow')}</span></span>
    <h1>{t(lang, 'st.h1')}</h1>
    <p>{t(lang, 'st.intro')}</p>
  </div>
</section>

<!-- Featured founder -->
<section class="section">
  <div class="wrap">
    <div class="founder">
      <div class="founder__media reveal-l">
        <img src="/photos/bert.jpg" alt={t(lang, 'media.altBert')} width="800" height="872" loading="lazy" />
      </div>
      <div class="founder__body reveal-r">
        <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'st.div1')}</span></span>
        <h2>{t(lang, 'st.p1.n')}</h2>
        <p class="founder__title">{t(lang, 'st.p1.t')}</p>
        <p class="founder__bio">{t(lang, 'st.p1.bio1')}</p>
        <p class="founder__bio">{t(lang, 'st.p1.bio2')}</p>
        <ul class="founder__creds">
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c1')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c2')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c3')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c4')}</span></li>
        </ul>
        <div class="founder__actions">
          <a class="btn btn-primary" href={localizePath('/bert-mahecha', lang)}>{t(lang, 'jr.link')}</a>
          <a class="btn btn-outline" href={localizePath('/about', lang)}>{t(lang, 'st.aboutBtn')}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- The rest of the team -->
<section class="section sky roster">
  <div class="wrap">
    <TeamShowcase client:visible groups={groups} />
    <p class="staff-growing reveal">{t(lang, 'st.growing')}</p>
  </div>
</section>

<CtaBanner lang={lang} />

<style>
  .founder {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .founder__media {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .founder__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .founder__body h2 {
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.02;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
  }
  .founder__body h2::after {
    content: '';
    display: block;
    width: 54px;
    height: 4px;
    border-radius: 2px;
    background: var(--gold);
    margin-top: 16px;
  }
  .founder__title {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue);
    font-size: 1.05rem;
  }
  .founder__bio {
    margin-top: 16px;
    color: var(--ink-soft);
    font-size: 1.04rem;
  }
  .founder__creds {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
  }
  .founder__creds li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.95rem;
    color: var(--ink);
    font-weight: 600;
  }
  .founder__creds .pent {
    margin-top: 4px;
  }
  .founder__actions {
    margin-top: 26px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 920px) {
    .founder {
      grid-template-columns: 1fr;
    }
    .founder__media {
      max-width: 420px;
    }
    .founder__creds {
      grid-template-columns: 1fr;
    }
  }
  .staff-growing {
    margin-top: 56px;
    color: var(--ink-soft);
    font-size: 1.02rem;
    max-width: 62ch;
  }
</style>
