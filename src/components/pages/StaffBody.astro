---
import { t, localizePath, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';
import TeamShowcase, { type TeamGroup } from '../react/TeamShowcase';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Bert leads the page in a featured founder section (the start of Executive
// Leadership); the staff follow in the TeamShowcase island (a 21st.dev component,
// see src/components/react).
//
// Structure per MFH's Team Page Restructure brief (Oct 2026), in this exact order:
// Executive Leadership, Scouting & Player Development (USA, then Colombia; each
// region's director first), Operations Support, Advisors & Independent Partners.
// Contractors appear only under Advisors, each with a firm name and disclaimer.
// Do not reorder or retitle without the client.
//
// Members without a headshot (Gustavo, Maria) get an initials tile until photos
// arrive. A member gets an expandable `blurb` only when they have approved copy:
// Fabian (p6), Andres (p5), and Ezzy (p2). Carlos expands to his independent
// partner bio. Advisor disclaimers (`note`) are always visible.

// Leagues and clubs Bert founded, owned, and presided over (his own list, Oct 2026).
// Names are proper nouns and stay untranslated; links go to each one's Facebook page.
const founded = [
  { name: 'South Florida Soccer League', year: 2004, logo: '/photos/leagues/sfsl.jpg', w: 240, h: 257, url: 'https://www.facebook.com/share/19a6WCqmCu/' },
  { name: 'South Florida FC', year: 2011, logo: '/photos/leagues/sffc.jpg', w: 217, h: 240, url: 'https://www.facebook.com/share/1FnN6iB542/' },
  { name: 'South Florida Youth Soccer League', year: 2013, logo: '/photos/leagues/sfysl.jpg', w: 180, h: 193, url: 'https://www.facebook.com/share/1CD7KYVYyG/' },
  { name: 'American Premier Soccer League', year: 2014, logo: '/photos/leagues/apsl.jpg', w: 320, h: 102, url: 'https://www.facebook.com/share/19VEQpDfdi/' },
];

// Gustavo's disclaimer is unconfirmed placeholder text. It renders, highlighted,
// on Vercel preview deployments and in local dev only. Every other build (Vercel
// production, a plain local build, a static upload) leaves his card out.
// TODO: replace with confirmed disclaimer from Gustavo Rodriguez before production,
// then delete `pending` and this gate.
const showPending = process.env.VERCEL_ENV === 'preview' || import.meta.env.DEV;

const divisions = [
  { key: 'st.div1', people: [{ key: 'st.p6', photo: '/photos/fabian.jpg', blurb: true }] },
  {
    key: 'st.div2',
    people: [
      { key: 'st.p2', photo: '/photos/ezzy.jpg', blurb: true, region: 'st.reg.usa' },
      { key: 'st.p3', photo: '/photos/sebastian.jpg', region: 'st.reg.usa' },
      { key: 'st.p4', photo: '/photos/john.jpg', region: 'st.reg.col' },
      { key: 'st.p10', photo: '/photos/andres-hernandez.jpg', region: 'st.reg.col' },
      { key: 'st.p13', photo: '/photos/abdellah.jpg', region: 'st.reg.emea' },
    ],
  },
  { key: 'st.div3', people: [{ key: 'st.p7' }] },
  {
    key: 'st.div4',
    people: [
      // Carlos: bio + disclaimer per his official one-pager (BM Accountax LLC).
      { key: 'st.p8', photo: '/photos/carlos.jpg', bio: true, note: true },
      { key: 'st.p5', photo: '/photos/andres.jpg', blurb: true, note: true },
      ...(showPending ? [{ key: 'st.p12', note: true, pending: true }] : []),
    ],
  },
];

const initials = (name: string) =>
  name
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();

// Resolve every string here so the island receives plain, already-translated data.
const groups: TeamGroup[] = divisions.map((d) => ({
  id: d.key,
  label: t(lang, d.key),
  members: d.people.map((person) => {
    const name = t(lang, `${person.key}.n`);
    return {
      id: person.key.replace('st.', ''),
      name,
      role: t(lang, `${person.key}.t`),
      initials: initials(name),
      image: 'photo' in person ? person.photo : undefined,
      blurb:
        'blurb' in person && person.blurb
          ? t(lang, `${person.key}.blurb`)
          : 'bio' in person && person.bio
            ? t(lang, `${person.key}.bio`)
            : undefined,
      note: 'note' in person && person.note ? t(lang, `${person.key}.note`) : undefined,
      pending: 'pending' in person && person.pending ? true : undefined,
      region: 'region' in person && person.region ? t(lang, person.region) : undefined,
    };
  }),
}));

// Founder structured data for search engines.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Bert Mahecha',
  jobTitle: 'Founder & CEO · FIFA-Licensed Football Agent',
  image: 'https://mfhglobal.football/photos/bert.jpg',
  sameAs: ['https://www.linkedin.com/in/berts'],
  worksFor: {
    '@type': 'SportsOrganization',
    name: 'MFH Global Football Agency',
    url: 'https://mfhglobal.football',
  },
  knowsLanguage: ['en', 'es'],
  hasCredential: [
    { '@type': 'EducationalOccupationalCredential', name: 'FIFA Football Agent License (2026)' },
    { '@type': 'EducationalOccupationalCredential', name: 'US Soccer National C Coaching License' },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />

<section class="page-hero">
  <img class="page-hero__bg" src="/photos/team-hero.jpg" alt="" width="1600" height="686" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'st.eyebrow')}</span></span>
    <h1>{t(lang, 'st.h1')}</h1>
    <p>{t(lang, 'st.intro')}</p>
  </div>
</section>

<!-- Featured founder -->
<section class="section">
  <div class="wrap">
    <div class="founder">
      <div class="founder__media reveal-l">
        <img src="/photos/bert.jpg" alt={t(lang, 'media.altBert')} width="800" height="872" loading="lazy" />
      </div>
      <div class="founder__body reveal-r">
        <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'st.div1')}</span></span>
        <h2>{t(lang, 'st.p1.n')}</h2>
        <p class="founder__title">{t(lang, 'st.p1.t')}</p>
        <p class="founder__bio">{t(lang, 'st.p1.bio1')}</p>
        <p class="founder__bio">{t(lang, 'st.p1.bio2')}</p>
        <ul class="founder__creds">
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c1')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c2')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c3')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'st.p1.c4')}</span></li>
        </ul>
        <div class="founded">
          <h3 class="founded__title">{t(lang, 'st.p1.fh')}</h3>
          <p class="founded__intro">{t(lang, 'st.p1.fi')}</p>
          <ul class="founded__list">
            {founded.map((f) => (
              <li>
                <a class="founded__item" href={f.url} target="_blank" rel="noopener noreferrer">
                  <span class="founded__logo"><img src={f.logo} alt="" width={f.w} height={f.h} loading="lazy" /></span>
                  <span class="founded__text">
                    <span class="founded__name">{f.name}</span>
                    <span class="founded__year">{f.year}</span>
                  </span>
                  <span class="sr-only">{t(lang, 'st.p1.fx')}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="founder__actions">
          <a class="btn btn-primary" href={localizePath('/bert-mahecha', lang)}>{t(lang, 'jr.link')}</a>
          <a class="btn btn-outline" href={localizePath('/about', lang)}>{t(lang, 'st.aboutBtn')}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- The rest of the team -->
<section class="section sky roster">
  <div class="wrap">
    <TeamShowcase client:visible groups={groups} />
    <p class="staff-growing reveal">{t(lang, 'st.growing')}</p>
  </div>
</section>

<CtaBanner lang={lang} />

<style>
  .founder {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .founder__media {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .founder__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .founder__body h2 {
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.02;
    font-size: clamp(2rem, 3.6vw, 2.9rem);
  }
  .founder__body h2::after {
    content: '';
    display: block;
    width: 54px;
    height: 4px;
    border-radius: 2px;
    background: var(--gold);
    margin-top: 16px;
  }
  .founder__title {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--blue);
    font-size: 1.05rem;
  }
  .founder__bio {
    margin-top: 16px;
    color: var(--ink-soft);
    font-size: 1.04rem;
  }
  .founder__creds {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
  }
  .founder__creds li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.95rem;
    color: var(--ink);
    font-weight: 600;
  }
  .founder__creds .pent {
    margin-top: 4px;
  }
  .founder__actions {
    margin-top: 26px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 920px) {
    .founder {
      grid-template-columns: 1fr;
    }
    .founder__media {
      max-width: 420px;
    }
    .founder__creds {
      grid-template-columns: 1fr;
    }
  }
  .founded {
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .founded__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0;
  }
  .founded__intro {
    margin: 8px 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  .founded__list {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .founded__item {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .founded__item:hover {
    border-color: var(--gold);
    box-shadow: var(--shadow-sm);
  }
  .founded__item:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  .founded__logo {
    flex: none;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    overflow: hidden;
    background: var(--paper);
  }
  .founded__logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .founded__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .founded__name {
    font-weight: 700;
    line-height: 1.2;
    font-size: 0.95rem;
  }
  .founded__year {
    margin-top: 2px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.78rem;
    color: var(--gold);
    letter-spacing: 0.06em;
  }
  @media (prefers-reduced-motion: reduce) {
    .founded__item {
      transition: none;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 520px) {
    .founded__list {
      grid-template-columns: 1fr;
    }
  }
  /* Staging-only marker for unconfirmed placeholder copy (Gustavo's disclaimer). */
  :global(.pending-confirmation) {
    background: #fff3a3;
    color: var(--ink);
    padding: 1px 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .staff-growing {
    margin-top: 56px;
    color: var(--ink-soft);
    font-size: 1.02rem;
    max-width: 62ch;
  }
</style>
