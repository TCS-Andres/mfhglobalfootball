---
import { t, localizePath, type Lang } from '../../i18n/ui';
import Pathway from '../Pathway.astro';
import CtaBanner from '../CtaBanner.astro';
import FaqSection from '../FaqSection.astro';
import EduVideo from '../EduVideo.astro';
import { VIDEOS } from '../../data/videos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const stories = ['pl.story1', 'pl.story2', 'pl.story3'];
// Bert's "The Five Steps" video walks through the pathway above.
const fiveSteps = VIDEOS.find((v) => v.key === 'v5')!;
const faqItems = [1, 2, 3].map((n) => ({ q: `pl.fq${n}`, a: `pl.fa${n}` }));
---

<section class="page-hero">
  <img class="page-hero__bg" src="/photos/plan-hero.jpg" alt="" width="1600" height="1067" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'pl.eyebrow')}</span></span>
    <h1>{t(lang, 'pl.h1')}</h1>
    <p>{t(lang, 'pl.intro')}</p>
  </div>
</section>

<!-- The MFH Pathway (circular ecosystem, replaces the old four-step block) -->
<Pathway lang={lang} />

<!-- Bert explains the five steps on video -->
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="head" style="text-align:center;margin-inline:auto">
      <span class="eyebrow" style="justify-content:center"><i class="pent"></i><span>{t(lang, 'vid.plan.eyebrow')}</span></span>
      <h2>{t(lang, 'vid.plan.h2')}</h2>
      <p class="lead">{t(lang, 'vid.plan.p')}</p>
    </div>
    <div class="plan-video reveal">
      <EduVideo lang={lang} video={fiveSteps} />
    </div>
    <p class="plan-video__more">
      <a class="btn btn-outline" href={localizePath('/videos', lang)}>{t(lang, 'vid.more')}</a>
    </p>
  </div>
</section>

<!-- Image break -->
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="media-slot reveal-scale" style="aspect-ratio:21/8">
      <img src="/photos/quote-parallax.jpg" alt={t(lang, 'media.altStadium')} width="1600" height="610" loading="lazy" />
    </div>
  </div>
</section>

<!-- Teaching stories -->
<section class="section sky">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'pl.stories.eyebrow')}</span></span>
      <h2>{t(lang, 'pl.stories.h2')}</h2>
      <p class="lead">{t(lang, 'pl.stories.intro')}</p>
    </div>
    <div class="stories">
      {stories.map((k, i) => (
        <div class="story reveal-scale" style={`--d:${i * 110}ms`}><i class="pent"></i><h3>{t(lang, `${k}.t`)}</h3><p>{t(lang, `${k}.d`)}</p></div>
      ))}
    </div>
  </div>
</section>

<FaqSection lang={lang} items={faqItems} tone="plain" />

<CtaBanner lang={lang} />

<style>
  .plan-video {
    max-width: 960px;
    margin: 0 auto;
  }
  .plan-video__more {
    text-align: center;
    margin-top: 28px;
  }
</style>
