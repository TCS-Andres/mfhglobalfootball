---
// Global Affiliates: an interactive dotted world map of MFH's affiliates, plus their cards.
//
// The map is built at compile time and ships as plain SVG and HTML: the dots come from
// src/data/world-dots.json (scripts/build-world-dots.mjs), the pins are projected here with
// the same Natural Earth projection, and a small inline script handles hover, focus, and tap.
// No map library and no React reach the browser.
import { geoNaturalEarth1 } from 'd3-geo';
import { t, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';
import world from '../../data/world-dots.json';
import { AFFILIATES, REGIONS, PIN_AT, MFH_BASES, COUNTRY_NUM, SCOUTS, type Affiliate, type Scout } from '../../data/affiliates';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const W = world.width;
const H = world.height;
const projection = geoNaturalEarth1()
  .scale(world.scale)
  .translate(world.translate as [number, number]);
const project = (lat: number, lng: number) => {
  const [x, y] = projection([lng, lat])!;
  return { x: +x.toFixed(1), y: +y.toFixed(1) };
};

// Dots are drawn as zero-length round-capped strokes in one path per layer, at double scale
// so every coordinate is a whole number (the grid sits on 2.5-unit steps).
const dotPath = (dots: (number | string)[][]) => dots.map(([x, y]) => `M${+x * 2} ${+y * 2}h0`).join('');
const dotsFor = (cc: string) => world.dots.filter((d) => d[2] === COUNTRY_NUM[cc]);

const regionName = new Intl.DisplayNames([lang === 'pt' ? 'pt-PT' : lang], { type: 'region' });
const country = (cc: string) => regionName.of(cc) ?? cc;
const unique = <T,>(xs: T[]) => [...new Set(xs)];

// MFH scouts join a base pin or a country pin (see SCOUTS). Cards and pins share ids so
// hovering either one lights up the other.
const scoutId = (sc: Scout) => `scout-${sc.key.replace('st.', '')}`;
const scoutsAt = (pin: string) => SCOUTS.filter((sc) => sc.pin === pin);

// One pin per country an affiliate works from. A pin that also hosts MFH scouts is drawn
// as an MFH pin (white), since MFH has its own people there.
const pins = unique(AFFILIATES.flatMap((a) => a.based)).map((cc) => {
  const affs = AFFILIATES.filter((a) => a.based.includes(cc));
  const scouts = scoutsAt(cc);
  return {
    cc,
    ...project(PIN_AT[cc].lat, PIN_AT[cc].lng),
    affs,
    scouts,
    ids: [...scouts.map(scoutId), ...affs.map((a) => a.id)],
    lights: unique([...scouts.map((sc) => sc.country), ...affs.flatMap((a) => [...a.based, ...a.focus])]),
  };
});
const bases = MFH_BASES.map((b) => {
  const scouts = scoutsAt(`base-${b.id}`);
  return {
    ...b,
    ...project(b.lat, b.lng),
    scouts,
    ids: scouts.map(scoutId),
    lights: unique([b.country, ...scouts.map((sc) => sc.country)]),
  };
});
const home = bases[0];

// Gentle arcs from the South Florida home base to every pin and to Colombia.
const arc = (from: { x: number; y: number }, to: { x: number; y: number }) => {
  const mx = (from.x + to.x) / 2;
  const my = (from.y + to.y) / 2;
  const lift = Math.hypot(to.x - from.x, to.y - from.y) * 0.32;
  return `M${from.x} ${from.y}Q${mx.toFixed(1)} ${(my - lift).toFixed(1)} ${to.x} ${to.y}`;
};
const arcs = [
  ...bases.slice(1).map((b) => ({ id: `base-${b.id}`, d: arc(home, b), base: true })),
  ...pins.map((p) => ({ id: p.cc, d: arc(home, p), base: p.scouts.length > 0 })),
];

// Country layers: MFH bases glow softly, affiliate countries are tinted, and every
// country an affiliate covers can light up gold on hover.
const baseCountries = MFH_BASES.map((b) => b.country);
const presence = unique(AFFILIATES.flatMap((a) => a.based));
const lightable = unique([
  ...SCOUTS.map((sc) => sc.country),
  ...MFH_BASES.map((b) => b.country),
  ...AFFILIATES.flatMap((a) => [...a.based, ...a.focus]),
]);

// Where each tooltip opens, so it never runs off the map.
const tipSide = (x: number, y: number) =>
  [x / W > 0.62 ? 'end' : x / W < 0.3 ? 'start' : 'mid', y / H < 0.42 ? 'below' : 'above'].join(' ');
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;

// Phones show a tighter crop around the network so neighbouring pins stay tappable.
const pts = [...pins, ...bases];
const pad = { x: 70, y: 45 };
const crop = {
  x0: Math.max(0, Math.min(...pts.map((p) => p.x)) - pad.x),
  y0: Math.max(0, Math.min(...pts.map((p) => p.y)) - pad.y),
  x1: Math.min(W, Math.max(...pts.map((p) => p.x)) + pad.x),
  y1: Math.min(H, Math.max(...pts.map((p) => p.y)) + pad.y),
};
const cropW = crop.x1 - crop.x0;
const cropH = crop.y1 - crop.y0;
const cropVars = [
  `--map-ratio:${W}/${H}`,
  `--crop-ratio:${cropW.toFixed(1)}/${cropH.toFixed(1)}`,
  `--crop-w:${((W / cropW) * 100).toFixed(2)}%`,
  `--crop-x:${((-crop.x0 / cropW) * 100).toFixed(2)}%`,
  `--crop-y:${((-crop.y0 / cropW) * 100).toFixed(2)}%`,
].join(';');

const stats = [
  { n: AFFILIATES.length, label: t(lang, 'aff.stat.affiliates') },
  { n: SCOUTS.length, label: t(lang, 'aff.stat.scouts') },
  { n: lightable.length, label: t(lang, 'aff.stat.countries') },
  { n: REGIONS.length, label: t(lang, 'aff.stat.regions') },
];
---

<section class="aff-hero">
  <div class="wrap">
    <div class="aff-hero__head">
      <div>
        <span class="eyebrow on-dark"><i class="pent"></i><span>{t(lang, 'aff.eyebrow')}</span></span>
        <h1>{t(lang, 'aff.h1')}</h1>
        <p>{t(lang, 'aff.intro')}</p>
      </div>
      <dl class="aff-stats">
        {stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.n}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="aff-map" data-aff-map style={cropVars}>
      <div class="aff-map__canvas">
        <div class="aff-map__stage">
          <svg class="aff-map__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t(lang, 'aff.mapLabel')}>
            <g transform="scale(0.5)">
              <path class="aff-dots" d={dotPath(world.dots)} />
              {baseCountries.map((cc) => <path class="aff-dots aff-dots--base" d={dotPath(dotsFor(cc))} />)}
              {presence.map((cc) => <path class="aff-dots aff-dots--presence" d={dotPath(dotsFor(cc))} />)}
              {lightable.map((cc) => <path class="aff-dots aff-dots--light" data-country={cc} d={dotPath(dotsFor(cc))} />)}
            </g>
            {arcs.map((a, i) => (
              <path class:list={['aff-arc', a.base && 'aff-arc--base']} data-arc={a.id} d={a.d} pathLength="1" style={`--i:${i}`} />
            ))}
          </svg>

          {bases.map((b, i) => (
            <button
              type="button"
              class="aff-pin aff-pin--base"
              style={`left:${pct(b.x, W)};top:${pct(b.y, H)};--i:${i}`}
              data-pin={`base-${b.id}`}
              data-lights={b.lights.join(' ')}
              data-affs={b.ids.join(' ')}
              aria-controls={`aff-tip-base-${b.id}`}
              aria-expanded="false"
            >
              <span class="aff-pin__sr">{t(lang, b.label)}</span>
            </button>
          ))}
          {pins.map((p, i) => (
            <button
              type="button"
              class:list={['aff-pin', p.scouts.length > 0 && 'aff-pin--base']}
              style={`left:${pct(p.x, W)};top:${pct(p.y, H)};--i:${i + bases.length}`}
              data-pin={p.cc}
              data-lights={p.lights.join(' ')}
              data-affs={p.ids.join(' ')}
              aria-controls={`aff-tip-${p.cc}`}
              aria-expanded="false"
            >
              <span class="aff-pin__sr">{country(p.cc)}</span>
            </button>
          ))}
        </div>
      </div>

      {bases.map((b) => (
        <div
          class={`aff-tip aff-tip--base ${tipSide(b.x, b.y)}`}
          id={`aff-tip-base-${b.id}`}
          data-tip={`base-${b.id}`}
          style={`left:${pct(b.x, W)};top:${pct(b.y, H)}`}
          role="region"
          aria-label={t(lang, b.label)}
          hidden
        >
          <p class="aff-tip__kicker">MFH Global Football Agency</p>
          <p class="aff-tip__title">{t(lang, b.label)}</p>
          {b.scouts.length > 0 && (
            <ul class="aff-tip__scouts">
              {b.scouts.map((sc) => (
                <li>
                  <p class="aff-tip__name">{t(lang, `${sc.key}.n`)}</p>
                  <p class="aff-tip__sub">{t(lang, `${sc.key}.t`)}</p>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
      {pins.map((p) => (
        <div
          class={`aff-tip ${tipSide(p.x, p.y)}`}
          id={`aff-tip-${p.cc}`}
          data-tip={p.cc}
          style={`left:${pct(p.x, W)};top:${pct(p.y, H)}`}
          role="region"
          aria-label={country(p.cc)}
          hidden
        >
          <p class="aff-tip__kicker">{country(p.cc)}</p>
          {p.scouts.length > 0 && (
            <>
              <p class="aff-tip__group">MFH Global Football Agency</p>
              <ul class="aff-tip__scouts">
                {p.scouts.map((sc) => (
                  <li>
                    <p class="aff-tip__name">{t(lang, `${sc.key}.n`)}</p>
                    <p class="aff-tip__sub">{t(lang, `${sc.key}.t`)}</p>
                  </li>
                ))}
              </ul>
              <p class="aff-tip__group">{t(lang, 'aff.tip.affiliates')}</p>
            </>
          )}
          <ul>
            {p.affs.map((a) => (
              <li>
                <p class="aff-tip__title">{a.org}</p>
                <p class="aff-tip__focus">
                  <span>{t(lang, 'aff.focus')}:</span> {a.focus.map(country).join(', ')}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="aff-legend">
      <ul>
        <li><i class="aff-key aff-key--base"></i>{t(lang, 'aff.legend.team')}</li>
        <li><i class="aff-key aff-key--pin"></i>{t(lang, 'aff.legend.affiliate')}</li>
        <li><i class="aff-key aff-key--focus"></i>{t(lang, 'aff.legend.focus')}</li>
      </ul>
      <p>{t(lang, 'aff.hint')}</p>
    </div>
  </div>
</section>

<section class="section aff-list">
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'aff.listEyebrow')}</span></span>
    <h2>{t(lang, 'aff.listH2')}</h2>

    <div class="aff-region">
      <h3 class="aff-region__name">{t(lang, 'aff.scouts.h')}</h3>
      <div class="aff-grid">
        {SCOUTS.map((sc, i) => (
          <article
            class="aff-card aff-card--scout reveal"
            style={`--d:${i * 80}ms`}
            data-aff-card={scoutId(sc)}
            data-pins={sc.pin}
            data-lights={sc.country}
          >
            <div class="aff-scout">
              {sc.photo ? (
                <img class="aff-scout__photo" src={sc.photo} alt="" width="64" height="64" loading="lazy" decoding="async" />
              ) : (
                <span class="aff-scout__photo aff-scout__initials" aria-hidden="true">
                  {t(lang, `${sc.key}.n`).split(' ').slice(0, 2).map((w) => w[0]).join('')}
                </span>
              )}
              <div>
                <h4>{t(lang, `${sc.key}.n`)}</h4>
                <p class="aff-card__role">{t(lang, `${sc.key}.t`)}</p>
              </div>
            </div>
            <dl>
              <div>
                <dt>{t(lang, 'aff.basedIn')}</dt>
                <dd><span class="aff-chip">{country(sc.country)}</span></dd>
              </div>
              <div>
                <dt>{t(lang, 'aff.regionLabel')}</dt>
                <dd><span class="aff-chip aff-chip--gold">{t(lang, sc.region)}</span></dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
    </div>

    {REGIONS.map((r) => (
      <div class="aff-region">
        <h3 class="aff-region__name">{t(lang, `aff.region.${r}`)}</h3>
        <div class="aff-grid">
          {AFFILIATES.filter((a) => a.region === r).map((a, i) => (
            <article
              class="aff-card reveal"
              style={`--d:${i * 80}ms`}
              data-aff-card={a.id}
              data-pins={a.based.join(' ')}
              data-lights={unique([...a.based, ...a.focus]).join(' ')}
            >
              <h4>{a.org}</h4>
              <dl>
                <div>
                  <dt>{t(lang, 'aff.basedIn')}</dt>
                  <dd>
                    {a.based.map((cc) => (
                      <span class="aff-chip">{a.cities?.[cc] ? `${a.cities[cc]}, ${country(cc)}` : country(cc)}</span>
                    ))}
                  </dd>
                </div>
                <div>
                  <dt>{t(lang, 'aff.focus')}</dt>
                  <dd>{a.focus.map((cc) => <span class="aff-chip aff-chip--gold">{country(cc)}</span>)}</dd>
                </div>
              </dl>
              {(a.website || a.transfermarkt) && (
                <p class="aff-card__links">
                  {a.website && (
                    <a href={a.website} target="_blank" rel="noopener">
                      {t(lang, 'aff.link.site')}
                    </a>
                  )}
                  {a.transfermarkt && (
                    <a href={a.transfermarkt} target="_blank" rel="noopener">
                      {t(lang, 'aff.link.tm')}
                    </a>
                  )}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    ))}

    <p class="aff-note">{t(lang, 'aff.note')}</p>
  </div>
</section>

<CtaBanner lang={lang} />

<script>
  const map = document.querySelector<HTMLElement>('[data-aff-map]');
  if (map) {
    map.classList.add('is-ready');
    const pins = [...map.querySelectorAll<HTMLButtonElement>('[data-pin]')];
    const tips = [...map.querySelectorAll<HTMLElement>('[data-tip]')];
    const layers = [...map.querySelectorAll<SVGPathElement>('[data-country]')];
    const arcs = [...map.querySelectorAll<SVGPathElement>('[data-arc]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-aff-card]')];
    const list = (el: Element, attr: string) => (el.getAttribute(attr) || '').split(' ').filter(Boolean);
    let pinned: string | null = null;

    // Light up a set of pins, countries, and cards. `tip` is the pin whose card opens.
    const show = (pinIds: string[], lights: string[], affs: string[], tip: string | null) => {
      map.classList.toggle('is-active', pinIds.length > 0);
      pins.forEach((p) => {
        const on = pinIds.includes(p.dataset.pin!);
        p.classList.toggle('is-on', on);
        p.setAttribute('aria-expanded', String(p.dataset.pin === tip));
      });
      tips.forEach((tp) => (tp.hidden = tp.dataset.tip !== tip));
      layers.forEach((l) => l.classList.toggle('is-on', lights.includes(l.dataset.country!)));
      arcs.forEach((a) => a.classList.toggle('is-on', pinIds.includes(a.dataset.arc!)));
      cards.forEach((c) => c.classList.toggle('is-on', affs.includes(c.dataset.affCard!)));
    };
    const showPin = (id: string) => {
      const p = pins.find((x) => x.dataset.pin === id);
      if (p) show([id], list(p, 'data-lights'), list(p, 'data-affs'), id);
    };
    const reset = () => (pinned ? showPin(pinned) : show([], [], [], null));

    pins.forEach((p) => {
      const id = p.dataset.pin!;
      p.addEventListener('mouseenter', () => showPin(id));
      p.addEventListener('focus', () => showPin(id));
      p.addEventListener('mouseleave', reset);
      p.addEventListener('blur', reset);
      // Tap or click keeps the card open (touch screens have no hover).
      p.addEventListener('click', () => {
        pinned = pinned === id ? null : id;
        reset();
      });
    });
    cards.forEach((c) => {
      const enter = () => show(list(c, 'data-pins'), list(c, 'data-lights'), [c.dataset.affCard!], null);
      c.addEventListener('mouseenter', enter);
      c.addEventListener('focusin', enter);
      c.addEventListener('mouseleave', reset);
      c.addEventListener('focusout', reset);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && pinned) {
        pinned = null;
        reset();
      }
    });
    document.addEventListener('click', (e) => {
      if (pinned && !(e.target as Element).closest('[data-pin], [data-tip]')) {
        pinned = null;
        reset();
      }
    });

    // Draw the arcs and drop the pins in once the map scrolls into view.
    const io = 'IntersectionObserver' in window
      ? new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            map.classList.add('is-in');
            io?.disconnect();
          }
        }, { threshold: 0.25 })
      : null;
    if (io) io.observe(map);
    else map.classList.add('is-in');
  }
</script>

<style>
  .aff-hero {
    background:
      radial-gradient(90% 70% at 70% 55%, rgba(0, 83, 145, 0.55), transparent 70%),
      var(--blue-deep);
    color: #fff;
    padding: clamp(72px, 12vw, 120px) 0 clamp(40px, 6vw, 64px);
    /* No overflow clipping: a busy pin's card may run past the bottom of the section.
       Sideways overflow is already clipped by main. */
    position: relative;
    z-index: 1;
  }
  .aff-hero .pent {
    background-image: url('/logos/ball.png');
  }
  .aff-hero__head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(24px, 5vw, 64px);
    align-items: end;
  }
  .aff-hero h1 {
    color: #fff;
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.03;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    margin: 14px 0 0;
  }
  .aff-hero__head p {
    color: rgba(255, 255, 255, 0.86);
    margin-top: 16px;
    max-width: 60ch;
    font-size: 1.08rem;
  }
  .aff-stats {
    display: flex;
    gap: clamp(18px, 3vw, 36px);
    margin: 0;
  }
  .aff-stats div {
    display: flex;
    flex-direction: column-reverse;
    border-left: 2px solid var(--gold);
    padding-left: 14px;
  }
  .aff-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1;
    color: #fff;
  }
  .aff-stats dt {
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  /* Map */
  .aff-map {
    position: relative;
    margin-top: clamp(32px, 5vw, 56px);
  }
  .aff-map__canvas {
    position: relative;
    aspect-ratio: var(--map-ratio);
    overflow: hidden;
  }
  .aff-map__stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--map-ratio);
  }
  .aff-map__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .aff-dots {
    fill: none;
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 5.2;
    stroke-linecap: round;
  }
  .aff-dots--base {
    stroke: rgba(228, 196, 94, 0.42);
  }
  .aff-dots--presence {
    stroke: rgba(255, 255, 255, 0.5);
  }
  .aff-dots--light {
    stroke: var(--gold);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .aff-dots--light.is-on {
    opacity: 1;
  }

  .aff-arc {
    fill: none;
    stroke: var(--gold-soft);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.55;
    transition:
      opacity 0.3s ease,
      stroke-width 0.3s ease;
  }
  .aff-arc--base {
    stroke: #fff;
    opacity: 0.4;
  }
  /* Entrance (only once the script runs, so the map still reads without JavaScript). */
  .is-ready .aff-arc {
    stroke-dashoffset: 1;
  }
  .is-in .aff-arc {
    animation: aff-draw 1.4s cubic-bezier(0.45, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * 0.18s + 0.2s);
  }
  .is-ready:not(.is-in) .aff-pin {
    opacity: 0;
  }
  .is-in .aff-pin {
    animation: aff-pop 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) backwards;
    animation-delay: calc(var(--i) * 0.12s);
  }
  @keyframes aff-pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }
  .is-active .aff-arc {
    opacity: 0.18;
  }
  .is-active .aff-arc.is-on {
    opacity: 1;
    stroke-width: 2.2;
  }
  @keyframes aff-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .aff-pin {
    position: absolute;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    padding: 0;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--gold);
    cursor: pointer;
    transition:
      transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1),
      box-shadow 0.25s ease;
  }
  .aff-pin::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    opacity: 0;
    animation: aff-pulse 2.6s ease-out infinite;
    animation-delay: calc(var(--i) * 0.4s);
    pointer-events: none;
  }
  .aff-pin--base {
    background: #fff;
    border-color: var(--gold);
    width: 14px;
    height: 14px;
