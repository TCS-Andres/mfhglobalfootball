---
import { t, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// The story told in alternating (ping-pong) rows, roughly chronological, with the
// World Cup broadcast moment as the closing chapter. Images render at their natural
// proportions so the whole photograph is always visible.
const items = [
  // Roughly chronological: playing days, then refereeing, coaching, league
  // leadership (APSL + FSSA), running his club, and the World Cup broadcast close.
  { key: 'mdc', type: 'img', src: '/photos/journey/mdc.jpg', w: 828, h: 638 },
  { key: 'asl', type: 'img', src: '/photos/journey/asl-u23.jpg', w: 828, h: 585 },
  { key: 'valderrama', type: 'img', src: '/photos/journey/valderrama.jpg', w: 408, h: 630 },
  { key: 'coaching', type: 'img', src: '/photos/journey/coaching-walk.jpg', w: 750, h: 503 },
  // APSL: Bert as President/Commissioner of the league he ran (2015-2018).
  { key: 'apsl', type: 'img', src: '/photos/journey/apsl.jpg', w: 1040, h: 1040 },
  { key: 'fssa', type: 'img', src: '/photos/journey/fssa.jpg', w: 1600, h: 1200 },
  { key: 'opencup', type: 'img', src: '/photos/journey/open-cup.jpg', w: 1080, h: 1162 },
  { key: 'video', type: 'video' },
];
---

<section class="page-hero">
  <img class="page-hero__bg" src="/videos/hero-still.jpg" alt="" width="1920" height="1080" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'jr.eyebrow')}</span></span>
    <h1>{t(lang, 'jr.h1')}</h1>
    <p>{t(lang, 'jr.intro')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="journey-story reveal">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'jr.gallery.eyebrow')}</span></span>
      <h2>{t(lang, 'jr.story.h2')}</h2>
      <p>{t(lang, 'jr.story.body1')}</p>
      <p>{t(lang, 'jr.story.body2')}</p>
    </div>
  </div>
</section>

<section class="section sky">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'jr.gallery.eyebrow')}</span></span>
      <h2>{t(lang, 'jr.gallery.h2')}</h2>
    </div>

    <div class="journey-rows">
      {items.map((it, i) => (
        <div class="jrow reveal" class:list={[{ 'jrow--flip': i % 2 === 1 }]}>
          <div class="jrow__media">
            {it.type === 'video' ? (
              <video
                controls
                preload="none"
                playsinline
                poster="/videos/bert-worldcup-poster.jpg"
                aria-label={t(lang, 'jr.c.video.aria')}
                width="854"
                height="480"
              >
                <source src="/videos/bert-worldcup.mp4" type="video/mp4" />
              </video>
            ) : (
              <img src={it.src} alt={t(lang, `jr.c.${it.key}.cap`)} width={it.w} height={it.h} loading="lazy" />
            )}
          </div>
          <div class="jrow__body">
            <span class="eyebrow"><i class="pent"></i><span>{t(lang, `jr.c.${it.key}.label`)}</span></span>
            <h3>{t(lang, `jr.c.${it.key}.head`)}</h3>
            <p>{t(lang, `jr.c.${it.key}.body`)}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<CtaBanner lang={lang} />

<style>
  .journey-story {
    max-width: 72ch;
    margin: 0 auto;
    text-align: center;
  }
  .journey-story .eyebrow {
    justify-content: center;
  }
  .journey-story h2 {
    margin-top: 14px;
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.03;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
  }
  .journey-story p {
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 1.06rem;
  }

  .journey-rows {
    display: grid;
    gap: clamp(44px, 6vw, 78px);
    margin-top: 8px;
  }
  .jrow {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 4.5vw, 60px);
    align-items: center;
  }
  .jrow__media {
    display: flex;
    justify-content: center;
  }
  .jrow__media img {
    max-width: 100%;
    max-height: 540px;
    width: auto;
    height: auto;
    display: block;
    border-radius: 14px;
    box-shadow: var(--shadow);
  }
  .jrow__media video {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    border-radius: 14px;
    box-shadow: var(--shadow);
    background: #000;
  }
  /* Ping-pong: even rows keep media left, odd rows move it to the right */
  .jrow--flip .jrow__media {
    order: 2;
  }

  .jrow__body h3 {
    margin-top: 12px;
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.05;
    font-size: clamp(1.5rem, 2.8vw, 2.1rem);
  }
  .jrow__body h3::after {
    content: '';
    display: block;
    width: 52px;
    height: 4px;
    border-radius: 2px;
    background: var(--gold);
    margin-top: 16px;
  }
  .jrow__body p {
    margin-top: 20px;
    color: var(--ink-soft);
    font-size: 1.05rem;
    max-width: 54ch;
  }

  @media (max-width: 820px) {
    .jrow {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .jrow--flip .jrow__media {
      order: 0;
    }
    .jrow__media img {
      max-height: 440px;
    }
  }
</style>
