---
import { t, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// The three photographs, in journey order. The World Cup clip is featured on its
// own above the grid because the moment is in the audio, not a still frame.
const photos = [
  { key: 'valderrama', src: '/photos/journey/valderrama.jpg', w: 408, h: 630 },
  { key: 'coaching', src: '/photos/journey/coaching-sffc.jpg', w: 1280, h: 853 },
  { key: 'opencup', src: '/photos/journey/open-cup.jpg', w: 1080, h: 1162 },
];
---

<section class="page-hero">
  <img class="page-hero__bg" src="/videos/hero-still.jpg" alt="" width="1920" height="1080" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'jr.eyebrow')}</span></span>
    <h1>{t(lang, 'jr.h1')}</h1>
    <p>{t(lang, 'jr.intro')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="journey-story reveal">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'jr.gallery.eyebrow')}</span></span>
      <h2>{t(lang, 'jr.story.h2')}</h2>
      <p>{t(lang, 'jr.story.body1')}</p>
      <p>{t(lang, 'jr.story.body2')}</p>
    </div>
  </div>
</section>

<section class="section sky">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'jr.gallery.eyebrow')}</span></span>
      <h2>{t(lang, 'jr.gallery.h2')}</h2>
    </div>

    <!-- Featured clip: the commentary moment (keeps audio, plays on click) -->
    <figure class="video-feature reveal">
      <div class="frame">
        <video
          controls
          preload="none"
          playsinline
          poster="/videos/bert-worldcup-poster.jpg"
          aria-label={t(lang, 'jr.c.video.aria')}
          width="854"
          height="480"
        >
          <source src="/videos/bert-worldcup.mp4" type="video/mp4" />
        </video>
      </div>
      <figcaption class="figcap">
        <span class="lbl">{t(lang, 'jr.c.video.label')}</span>
        <span class="txt">{t(lang, 'jr.c.video.cap')}</span>
      </figcaption>
    </figure>

    <div class="journey-figs">
      {photos.map((ph, i) => (
        <figure class="jf reveal" style={`--d:${i * 90}ms`}>
          <div class="jf__media">
            <img
              src={ph.src}
              alt={t(lang, `jr.c.${ph.key}.cap`)}
              width={ph.w}
              height={ph.h}
              loading="lazy"
            />
          </div>
          <figcaption class="figcap">
            <span class="lbl">{t(lang, `jr.c.${ph.key}.label`)}</span>
            <span class="txt">{t(lang, `jr.c.${ph.key}.cap`)}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<CtaBanner lang={lang} />

<style>
  .journey-story {
    max-width: 72ch;
    margin: 0 auto;
    text-align: center;
  }
  .journey-story .eyebrow {
    justify-content: center;
  }
  .journey-story h2 {
    margin-top: 14px;
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.015em;
    line-height: 1.03;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
  }
  .journey-story p {
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 1.06rem;
  }

  .video-feature {
    max-width: 820px;
    margin: 8px auto 52px;
  }
  .video-feature .frame {
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
    background: #000;
  }
  .video-feature video {
    width: 100%;
    height: 100%;
    display: block;
  }

  .journey-figs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 8px;
  }
  .jf {
    margin: 0;
  }
  .jf__media {
    height: clamp(260px, 32vw, 360px);
    display: grid;
    place-items: center;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .jf__media img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .figcap {
    margin-top: 14px;
    text-align: center;
  }
  .figcap .lbl {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: var(--blue);
  }
  .figcap .txt {
    display: block;
    margin: 6px auto 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 46ch;
  }

  @media (max-width: 820px) {
    .journey-figs {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
    }
  }
</style>
