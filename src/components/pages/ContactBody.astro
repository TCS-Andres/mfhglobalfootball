---
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Booking and form sources come from environment variables with sensible defaults.
// PUBLIC_BOOKING_URL : a Calendly (or similar) scheduling URL for the consultation block.
//   Defaults to the client's live Calendly, a public link that is safe to ship in the build.
// PUBLIC_FORM_ENDPOINT : an explicit Formspree/Web3Forms POST URL (optional; overrides the key).
// PUBLIC_WEB3FORMS_KEY : a Web3Forms access key. Submissions email to the address the key is
//   registered to (set it up for info@mfhglobal.football). Preferred zero-backend option.
// PUBLIC_CONTACT_EMAIL : address for the pre-filled mailto fallback (defaults to the club inbox).
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || 'https://calendly.com/mfhglobal-football';
const isCalendly = /calendly\.com/i.test(bookingUrl);
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const web3Key = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? 'info@mfhglobal.football';
// POST target: explicit endpoint wins; otherwise Web3Forms when a key is configured.
const formAction = formEndpoint || (web3Key ? 'https://api.web3forms.com/submit' : '');
const useWeb3 = !formEndpoint && Boolean(web3Key);

const mailSubjects: Record<string, string> = {
  en: 'Free consultation request',
  es: 'Solicitud de consulta gratis',
  fr: 'Demande de consultation gratuite',
  it: 'Richiesta di consulenza gratuita',
  pt: 'Pedido de consulta gratuita',
};
const mailSubject = encodeURIComponent(mailSubjects[lang] ?? mailSubjects.en);
// Client rule (Aug 2026): footage-form age brackets are U16, U18, U21, U23, Other.
const ageCodes = ['U16', 'U18', 'U21', 'U23'];
const otherByLang: Record<string, string> = { en: 'Other', es: 'Otro', fr: 'Autre', it: 'Altro', pt: 'Outro' };
const ages = [...ageCodes, otherByLang[lang] ?? otherByLang.en];
const positionsByLang: Record<string, string[]> = {
  en: ['Goalkeeper', 'Defender', 'Midfielder', 'Forward', 'Other'],
  es: ['Portero', 'Defensa', 'Mediocampista', 'Delantero', 'Otra'],
  fr: ['Gardien', 'Défenseur', 'Milieu', 'Attaquant', 'Autre'],
  it: ['Portiere', 'Difensore', 'Centrocampista', 'Attaccante', 'Altro'],
  pt: ['Guarda-redes', 'Defesa', 'Médio', 'Avançado', 'Outra'],
};
const positions = positionsByLang[lang] ?? positionsByLang.en;
---

<section class="page-hero">
  <img class="page-hero__bg" src="/photos/contact-hero.jpg" alt="" width="1000" height="625" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'ct.eyebrow')}</span></span>
    <h1>{t(lang, 'ct.h1')}</h1>
    <p>{t(lang, 'ct.intro')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="contact-grid">
      <!-- Block 1: Book a free consultation. Calendly inline widget when configured. -->
      <div class="panel-card">
        <h2>{t(lang, 'ct.book.h2')}</h2>
        <p>{t(lang, 'ct.book.d')}</p>
        {bookingUrl ? (
          isCalendly ? (
            <div class="booking-cal">
              <div
                class="calendly-inline-widget"
                data-url={`${bookingUrl}?hide_gdpr_banner=1&primary_color=005391`}
                style="min-width:320px;height:660px"
              ></div>
              <p class="booking-direct">
                <a href={bookingUrl} target="_blank" rel="noopener">{t(lang, 'ct.book.direct')}</a>
              </p>
              <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>
            </div>
          ) : (
            <iframe
              class="booking-embed"
              src={bookingUrl}
              title={t(lang, 'ct.book.h2')}
              loading="lazy"
            ></iframe>
          )
        ) : (
          <>
            <p style="margin-top:16px">{t(lang, 'ct.book.fallback')}</p>
            <div class="form-actions">
              <a class="btn btn-primary" href={`mailto:${contactEmail}?subject=${mailSubject}`}>
                {t(lang, 'ct.book.button')}
              </a>
            </div>
          </>
        )}
      </div>

      <!-- Block 2: Share your footage -->
      <div class="panel-card">
        <h2>{t(lang, 'ct.footage.h2')}</h2>
        <p>{t(lang, 'ct.footage.d')}</p>
        <form
          id="footage-form"
          method="POST"
          action={formAction || undefined}
          data-fallback-email={contactEmail}
          data-msg-sending={t(lang, 'ct.f.sending')}
          data-msg-success={t(lang, 'ct.f.success')}
          data-msg-error={t(lang, 'ct.f.error')}
          novalidate
        >
          {useWeb3 && (
            <>
              <input type="hidden" name="access_key" value={web3Key} />
              <input type="hidden" name="subject" value="New footage submission from the MFH Global Football website" />
              <input type="hidden" name="from_name" value="MFH Global Football website" />
              <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
            </>
          )}
          <div class="field">
            <label for="f-name">{t(lang, 'ct.f.name')} <span class="req">({t(lang, 'ct.f.required')})</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="f-contact">{t(lang, 'ct.f.email')} <span class="req">({t(lang, 'ct.f.required')})</span></label>
            <input id="f-contact" name="contact" type="text" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="f-age">{t(lang, 'ct.f.age')}</label>
            <select id="f-age" name="age_group">
              {ages.map((a) => <option value={a}>{a}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-position">{t(lang, 'ct.f.position')}</label>
            <select id="f-position" name="position">
              {positions.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-link">{t(lang, 'ct.f.link')} <span class="req">({t(lang, 'ct.f.required')})</span></label>
            <input id="f-link" name="footage_link" type="url" inputmode="url" placeholder="https://" required />
            <small>{t(lang, 'ct.f.linkHelp')}</small>
          </div>
          <div class="field">
            <label for="f-message">{t(lang, 'ct.f.message')}</label>
            <textarea id="f-message" name="message" rows="3"></textarea>
          </div>
          <div class="form-actions">
            <button class="btn btn-primary" type="submit">{t(lang, 'ct.f.submit')}</button>
          </div>
          <p class="form-status" id="footage-status" role="status" aria-live="polite" hidden></p>
        </form>
        <div class="contact-details">
          <h2 style="font-size:1.1rem;margin-top:8px">{t(lang, 'ct.details.h2')}</h2>
          <span>{t(lang, 'ct.details.location')}</span>
          <span>{t(lang, 'ct.details.langs')}</span>
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .booking-cal {
    margin-top: 16px;
  }
  .booking-direct {
    margin-top: 12px;
    font-size: 0.9rem;
  }
  .booking-direct a {
    color: var(--blue);
    font-weight: 600;
  }
  .form-status {
    margin-top: 14px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .form-status[data-kind='ok'] {
    color: var(--blue);
  }
  .form-status[data-kind='err'] {
    color: #b00020;
  }
  .form-status[data-kind='sending'] {
    color: var(--ink-soft);
  }
</style>

<section class="section sky">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'ct.next.eyebrow')}</span></span>
      <h2>{t(lang, 'ct.next.h2')}</h2>
    </div>
    <div class="plan-grid plan-grid--3">
      {[1, 2, 3].map((n, i) => (
        <div class="step reveal" style={`--d:${i * 110}ms`}>
          <div class="num">{n}</div>
          <h3>{t(lang, `ct.next.${n}.t`)}</h3>
          <p>{t(lang, `ct.next.${n}.d`)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Footage form: validate, then submit to the configured endpoint (Web3Forms /
  // Formspree) in the background so the submission emails to info@mfhglobal.football.
  // With no endpoint set, fall back to a fully pre-filled email to the club inbox.
  const form = document.getElementById('footage-form') as HTMLFormElement | null;
  const status = document.getElementById('footage-status');
  if (form) {
    const setStatus = (msg: string, kind: string) => {
      if (!status) return;
      status.textContent = msg;
      status.dataset.kind = kind;
      status.hidden = false;
    };
    form.addEventListener('submit', async (e) => {
      const link = form.querySelector<HTMLInputElement>('#f-link');
      if (link && link.value) {
        try {
          const u = new URL(link.value);
          if (u.protocol !== 'http:' && u.protocol !== 'https:') throw new Error('bad protocol');
          link.setCustomValidity('');
        } catch {
          link.setCustomValidity(link.title || 'Please enter a valid URL.');
        }
      }
      if (!form.checkValidity()) {
        e.preventDefault();
        form.reportValidity();
        return;
      }
      e.preventDefault();
      const action = form.getAttribute('action');
      const data = new FormData(form);

      // No server endpoint: open a pre-filled email to the club inbox with every field.
      if (!action) {
        const email = form.dataset.fallbackEmail || 'info@mfhglobal.football';
        const g = (k: string) => (data.get(k) || '').toString();
        const body = [
          'Name: ' + g('name'),
          'Contact: ' + g('contact'),
          'Age group: ' + g('age_group'),
          'Position: ' + g('position'),
          'Footage link: ' + g('footage_link'),
          '',
          g('message'),
        ].join('\n');
        window.location.href =
          'mailto:' + email +
          '?subject=' + encodeURIComponent('Footage submission from the MFH Global Football website') +
          '&body=' + encodeURIComponent(body);
        return;
      }

      // Server endpoint configured: submit in the background and report the result.
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.disabled = true;
      setStatus(form.dataset.msgSending || 'Sending...', 'sending');
      try {
        const res = await fetch(action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (res.ok) {
          form.reset();
          setStatus(form.dataset.msgSuccess || 'Thank you.', 'ok');
        } else {
          setStatus(form.dataset.msgError || 'Something went wrong.', 'err');
        }
      } catch {
        setStatus(form.dataset.msgError || 'Something went wrong.', 'err');
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
