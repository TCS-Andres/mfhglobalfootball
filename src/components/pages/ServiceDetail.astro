---
import { t, localizePath, type Lang } from '../../i18n/ui';
import PingPong from '../PingPong.astro';
import Pathway from '../Pathway.astro';
import StatsBand from '../StatsBand.astro';
import MeetBert from '../MeetBert.astro';
import FaqSection from '../FaqSection.astro';
import CtaBanner from '../CtaBanner.astro';

interface Props {
  lang: Lang;
  service: 'youth' | 'player' | 'transfers' | 'coach' | 'eval';
}
const { lang, service } = Astro.props;

// slug, hero image, and the four ping-pong images (none repeats that page's hero).
const SERVICES = {
  youth: {
    slug: 'youth-family-advisory',
    img: '/photos/svc-youth-hero.jpg',
    pp: ['/photos/svc-youth-pp1.jpg', '/photos/svc-youth-pp2.jpg', '/photos/svc-youth-pp3.jpg', '/photos/svc-youth-pp4.jpg'],
  },
  player: {
    slug: 'player-representation',
    img: '/photos/svc-player-hero.jpg',
    pp: ['/photos/svc-player-pp1.jpg', '/photos/svc-player-pp2.jpg', '/photos/svc-player-pp3.jpg', '/photos/svc-player-pp4.jpg'],
  },
  transfers: {
    slug: 'transfers',
    img: '/photos/svc-transfers-hero.jpg',
    pp: ['/photos/svc-transfers-pp1.jpg', '/photos/svc-transfers-pp2.jpg', '/photos/svc-transfers-pp3.jpg', '/photos/svc-transfers-pp4.jpg'],
  },
  coach: {
    slug: 'coach-representation',
    img: '/photos/svc-coach-hero.jpg',
    pp: ['/photos/svc-coach-pp1.jpg', '/photos/svc-coach-pp2.jpg', '/photos/svc-coach-pp3.jpg', '/photos/svc-coach-pp4.jpg'],
  },
  eval: {
    slug: 'player-evaluation',
    img: '/photos/svc-eval-hero.jpg',
    pp: ['/photos/svc-eval-pp1.jpg', '/photos/svc-eval-pp2.jpg', '/photos/svc-eval-pp3.jpg', '/photos/svc-eval-pp4.jpg'],
  },
} as const;

const cfg = SERVICES[service];
const k = (suffix: string) => t(lang, `sv.${service}.${suffix}`);
const ppItems = [0, 1, 2, 3].map((i) => ({
  title: `sv.${service}.i${i + 1}`,
  body: `sv.${service}.d${i + 1}`,
  img: cfg.pp[i],
}));
const faqItems = [1, 2, 3].map((n) => ({ q: `sv.${service}.fq${n}`, a: `sv.${service}.fa${n}` }));

const site = Astro.site ?? new URL('https://mfhglobal.football');
const pageUrl = new URL(localizePath(`/services/${cfg.slug}`, lang), site).href;
const servicesUrl = new URL(localizePath('/services', lang), site).href;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: k('name'),
  serviceType: k('name'),
  description: k('metaDesc'),
  url: pageUrl,
  areaServed: ['US', 'CO', 'Europe'],
  provider: { '@type': 'SportsOrganization', name: 'MFH Global Football Agency', url: site.href },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav.services'), item: servicesUrl },
    { '@type': 'ListItem', position: 2, name: k('name'), item: pageUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

<section class="page-hero">
  <img class="page-hero__bg" src={cfg.img} alt="" width="1600" height="686" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={localizePath('/services', lang)}>{t(lang, 'nav.services')}</a>
      <span aria-hidden="true">/</span>
      <span>{k('name')}</span>
    </nav>
    <span class="eyebrow"><i class="pent"></i><span>{k('eyebrow')}</span></span>
    <h1>{k('h1')}</h1>
    <p>{k('intro')}</p>
  </div>
</section>

<!-- What this includes, as ping-pong rows -->
<PingPong
  lang={lang}
  eyebrowKey={`sv.${service}.name`}
  headingKey="sv.detail.incl"
  leadKey={`sv.${service}.close`}
  items={ppItems}
  tone="sky"
/>

<!-- The MFH Pathway (circular ecosystem, replaces the old four-step block) -->
<Pathway lang={lang} />

<!-- The experience you can count on (counter) -->
<StatsBand lang={lang} />

<!-- The person in your corner (Bert) -->
<MeetBert lang={lang} />

<!-- FAQs -->
<FaqSection lang={lang} items={faqItems} tone="plain" />

<CtaBanner lang={lang} />
