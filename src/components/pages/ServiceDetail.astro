---
import { t, localizePath, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';

interface Props {
  lang: Lang;
  service: 'youth' | 'player' | 'transfers' | 'coach' | 'eval';
}
const { lang, service } = Astro.props;

// slug, hero image, and the two related services shown at the bottom of each page.
const SERVICES = {
  youth: { slug: 'youth-family-advisory', img: '/photos/youth-pathway.jpg', related: ['player', 'transfers'] },
  player: { slug: 'player-representation', img: '/photos/services-players.jpg', related: ['transfers', 'eval'] },
  transfers: { slug: 'transfers', img: '/photos/bridge-colombia.jpg', related: ['player', 'coach'] },
  coach: { slug: 'coach-representation', img: '/photos/about-mentor.jpg', related: ['player', 'eval'] },
  eval: { slug: 'player-evaluation', img: '/photos/services-players.jpg', related: ['youth', 'player'] },
} as const;

const cfg = SERVICES[service];
const k = (suffix: string) => t(lang, `sv.${service}.${suffix}`);
const includes = ['i1', 'i2', 'i3', 'i4'];

const site = Astro.site ?? new URL('https://mfhglobal.football');
const pageUrl = new URL(localizePath(`/services/${cfg.slug}`, lang), site).href;
const servicesUrl = new URL(localizePath('/services', lang), site).href;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: k('name'),
  serviceType: k('name'),
  description: k('metaDesc'),
  url: pageUrl,
  areaServed: ['US', 'CO', 'Europe'],
  provider: {
    '@type': 'SportsOrganization',
    name: 'MFH Global Football',
    url: site.href,
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav.services'), item: servicesUrl },
    { '@type': 'ListItem', position: 2, name: k('name'), item: pageUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

<section class="page-hero">
  <img class="page-hero__bg" src={cfg.img} alt="" width="1600" height="686" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={localizePath('/services', lang)}>{t(lang, 'nav.services')}</a>
      <span aria-hidden="true">/</span>
      <span>{k('name')}</span>
    </nav>
    <span class="eyebrow"><i class="pent"></i><span>{k('eyebrow')}</span></span>
    <h1>{k('h1')}</h1>
    <p>{k('intro')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="svc-detail">
      <div class="svc-detail__main reveal">
        <h2>{t(lang, 'sv.detail.incl')}</h2>
        <ul class="incl">
          {includes.map((n) => (
            <li>
              <span class="incl__check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12.5l4.2 4.2L19 7" />
                </svg>
              </span>
              <span>{k(n)}</span>
            </li>
          ))}
        </ul>
        <p class="svc-detail__close">{k('close')}</p>
        <a class="btn btn-primary" href={localizePath('/contact', lang)}>{t(lang, 'cta.consult')}</a>
      </div>
    </div>
  </div>
</section>

<section class="section sky">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'sv.detail.related')}</span></span>
    </div>
    <div class="grid g3">
      {cfg.related.map((r) => (
        <a class="card card--link reveal" href={localizePath(`/services/${SERVICES[r as keyof typeof SERVICES].slug}`, lang)}>
          <i class="pent"></i>
          <h3>{t(lang, `sv.${r}.name`)}</h3>
          <p>{t(lang, `sv.${r}.intro`)}</p>
          <span class="card__go">{t(lang, 'faq.more')}</span>
        </a>
      ))}
      <a class="card card--link reveal" href={localizePath('/faq', lang)}>
        <i class="pent"></i>
        <h3>{t(lang, 'nav.faq')}</h3>
        <p>{t(lang, 'faq.intro')}</p>
        <span class="card__go">{t(lang, 'faq.more')}</span>
      </a>
    </div>
  </div>
</section>

<CtaBanner lang={lang} />

<style>
  .crumbs {
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #cddcec;
    margin-bottom: 18px;
  }
  .crumbs a {
    color: var(--gold-soft);
  }
  .crumbs a:hover {
    color: #fff;
  }
  .crumbs span[aria-hidden] {
    opacity: 0.5;
  }

  .svc-detail__main {
    max-width: 760px;
  }
  .svc-detail__main > h2 {
    font-size: 1.5rem;
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.01em;
  }
  .incl {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 28px;
  }
  .incl li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    font-size: 1.04rem;
    color: var(--ink);
    font-weight: 600;
  }
  .incl__check {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--sky);
    color: var(--blue);
    display: grid;
    place-items: center;
    margin-top: 1px;
  }
  .incl__check svg {
    width: 15px;
    height: 15px;
  }
  .svc-detail__close {
    margin-top: 28px;
    font-size: 1.1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .svc-detail__main .btn {
    margin-top: 26px;
  }

  @media (max-width: 620px) {
    .incl {
      grid-template-columns: 1fr;
    }
  }
</style>
