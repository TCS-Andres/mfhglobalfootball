---
import { t, localizePath, type Lang } from '../../i18n/ui';
import PingPong from '../PingPong.astro';
import Pathway from '../Pathway.astro';
import StatsBand from '../StatsBand.astro';
import MeetBert from '../MeetBert.astro';
import FaqSection from '../FaqSection.astro';
import CtaBanner from '../CtaBanner.astro';

interface Props {
  lang: Lang;
  service: 'youth' | 'player' | 'transfers' | 'coach' | 'eval';
}
const { lang, service } = Astro.props;

// slug, hero image, and the four ping-pong images (none repeats that page's hero).
const SERVICES = {
  youth: {
    slug: 'youth-family-advisory',
    img: '/photos/svc-youth-hero.jpg',
    pp: ['/photos/svc-youth-pp1.jpg', '/photos/svc-youth-pp2.jpg', '/photos/svc-youth-pp3.jpg', '/photos/svc-youth-pp4.jpg'],
  },
  player: {
    slug: 'player-representation',
    img: '/photos/svc-player-hero.jpg',
    pp: ['/photos/svc-player-pp1.jpg', '/photos/svc-player-pp2.jpg', '/photos/svc-player-pp3.jpg', '/photos/svc-player-pp4.jpg'],
  },
  transfers: {
    slug: 'transfers',
    img: '/photos/svc-transfers-hero.jpg',
    pp: ['/photos/svc-transfers-pp1.jpg', '/photos/svc-transfers-pp2.jpg', '/photos/svc-transfers-pp3.jpg', '/photos/svc-transfers-pp4.jpg'],
  },
  coach: {
    slug: 'coach-representation',
    img: '/photos/svc-coach-hero.jpg',
    pp: ['/photos/svc-coach-pp1.jpg', '/photos/svc-coach-pp2.jpg', '/photos/svc-coach-pp3.jpg', '/photos/svc-coach-pp4.jpg'],
  },
  eval: {
    slug: 'player-evaluation',
    img: '/photos/svc-eval-hero.jpg',
    pp: ['/photos/svc-eval-pp1.jpg', '/photos/svc-eval-pp2.jpg', '/photos/svc-eval-pp3.jpg', '/photos/svc-eval-pp4.jpg'],
  },
} as const;

const cfg = SERVICES[service];
const k = (suffix: string) => t(lang, `sv.${service}.${suffix}`);
const ppItems = [0, 1, 2, 3].map((i) => ({
  title: `sv.${service}.i${i + 1}`,
  body: `sv.${service}.d${i + 1}`,
  img: cfg.pp[i],
}));
const faqItems = [1, 2, 3].map((n) => ({ q: `sv.${service}.fq${n}`, a: `sv.${service}.fa${n}` }));

const site = Astro.site ?? new URL('https://mfhglobal.football');
const pageUrl = new URL(localizePath(`/services/${cfg.slug}`, lang), site).href;
const servicesUrl = new URL(localizePath('/services', lang), site).href;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: k('name'),
  serviceType: k('name'),
  description: k('metaDesc'),
  url: pageUrl,
  areaServed: ['US', 'CO', 'Europe'],
  provider: { '@type': 'SportsOrganization', name: 'MFH Global Football Agency', url: site.href },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'nav.services'), item: servicesUrl },
    { '@type': 'ListItem', position: 2, name: k('name'), item: pageUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

<section class="page-hero">
  <img class="page-hero__bg" src={cfg.img} alt="" width="1600" height="686" fetchpriority="high" />
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={localizePath('/services', lang)}>{t(lang, 'nav.services')}</a>
      <span aria-hidden="true">/</span>
      <span>{k('name')}</span>
    </nav>
    <span class="eyebrow"><i class="pent"></i><span>{k('eyebrow')}</span></span>
    <h1>{k('h1')}</h1>
    <p>{k('intro')}</p>
  </div>
</section>

<!-- What this includes, as ping-pong rows -->
<PingPong
  lang={lang}
  eyebrowKey={`sv.${service}.name`}
  headingKey="sv.detail.incl"
  leadKey={`sv.${service}.close`}
  items={ppItems}
  tone="sky"
/>

<!-- The MFH Pathway (circular ecosystem, replaces the old four-step block) -->
<Pathway lang={lang} />

<!-- The experience you can count on (counter) -->
<StatsBand lang={lang} />

<!-- The person in your corner (Bert) -->
<MeetBert lang={lang} />

<!-- FAQs -->
<FaqSection lang={lang} items={faqItems} tone="plain" />

{service === 'eval' && (
  <section class="section sky" id="analytic-soccer">
    <div class="wrap">
      <div class="partner">
        <a
          class="partner__logo"
          href="https://analyticsoccer.com/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Analytic Soccer, opens in a new tab"
        >
          <img src="/photos/analytic-soccer.webp" alt="Analytic Soccer" width="1080" height="764" loading="lazy" />
        </a>
        <div class="partner__body reveal-r">
          <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'as.eyebrow')}</span></span>
          <h2>{t(lang, 'as.title')}</h2>
          <p>{t(lang, 'as.body')}</p>
          <ul class="partner__points">
            <li><i class="pent"></i><span>{t(lang, 'as.b1')}</span></li>
            <li><i class="pent"></i><span>{t(lang, 'as.b2')}</span></li>
            <li><i class="pent"></i><span>{t(lang, 'as.b3')}</span></li>
          </ul>
          <a class="btn btn-primary" href="https://analyticsoccer.com/" target="_blank" rel="noopener noreferrer">
            {t(lang, 'as.cta')}
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<CtaBanner lang={lang} />

<style>
  .partner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  .partner__logo {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(24px, 4vw, 40px);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .partner__logo:hover,
  .partner__logo:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(12, 27, 41, 0.16);
  }
  .partner__logo img {
    width: 100%;
    height: auto;
    display: block;
  }
  .partner__body h2 {
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1.08;
    font-size: clamp(1.55rem, 2.8vw, 2.15rem);
    margin-top: 14px;
  }
  .partner__body > p {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 1.04rem;
  }
  .partner__points {
    list-style: none;
    margin: 20px 0 26px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .partner__points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 600;
    color: var(--ink);
  }
  .partner__points .pent {
    margin-top: 5px;
    flex: none;
  }
  @media (max-width: 860px) {
    .partner {
      grid-template-columns: 1fr;
    }
    .partner__logo {
      max-width: 440px;
    }
  }
</style>
