---
import { t, localizePath, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Each FAQ links out to the most relevant existing page (internal-linking depth).
const items = [
  { key: 'faq.q1', link: '/services' },
  { key: 'faq.q2', link: '/contact' },
  { key: 'faq.q3', link: '/services' },
  { key: 'faq.q4', link: '/about' },
  { key: 'faq.q5', link: '/the-mfh-plan' },
  { key: 'faq.q6', link: '/services' },
  { key: 'faq.q7', link: '/contact' },
];

// FAQPage structured data, plain-text answers for rich results.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: t(lang, `${it.key}.q`),
    acceptedAnswer: { '@type': 'Answer', text: t(lang, `${it.key}.a`) },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<section class="page-hero page-hero--plain">
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'faq.eyebrow')}</span></span>
    <h1>{t(lang, 'faq.h1')}</h1>
    <p>{t(lang, 'faq.intro')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="faq-list">
      {items.map((it, i) => (
        <details class="faq-item reveal" style={`--d:${i * 60}ms`}>
          <summary>{t(lang, `${it.key}.q`)}</summary>
          <div class="faq-answer">
            <p>{t(lang, `${it.key}.a`)}</p>
            <a class="faq-more" href={localizePath(it.link, lang)}>{t(lang, 'faq.more')}</a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBanner lang={lang} />

<style>
  /* A plain navy hero band (no photo) for the FAQ intro. The accordion styles
     (.faq-list / .faq-item / .faq-answer / .faq-more) live in global.css so
     embedded FAQ sections on other pages can share them. */
  .page-hero--plain {
    background: radial-gradient(120% 120% at 85% 0%, #0a4f86 0%, var(--blue) 32%, var(--blue-deep) 100%);
  }
  .page-hero--plain .page-hero__scrim {
    background: none;
  }
</style>
