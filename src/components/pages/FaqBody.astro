---
import { t, localizePath, type Lang } from '../../i18n/ui';
import CtaBanner from '../CtaBanner.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Each FAQ links out to the most relevant existing page (internal-linking depth).
const items = [
  { key: 'faq.q1', link: '/services' },
  { key: 'faq.q2', link: '/contact' },
  { key: 'faq.q3', link: '/services' },
  { key: 'faq.q4', link: '/about' },
  { key: 'faq.q5', link: '/the-mfh-plan' },
  { key: 'faq.q6', link: '/services' },
  { key: 'faq.q7', link: '/contact' },
];

// FAQPage structured data, plain-text answers for rich results.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: t(lang, `${it.key}.q`),
    acceptedAnswer: { '@type': 'Answer', text: t(lang, `${it.key}.a`) },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<section class="page-hero page-hero--plain">
  <div class="page-hero__scrim"></div>
  <div class="wrap">
    <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'faq.eyebrow')}</span></span>
    <h1>{t(lang, 'faq.h1')}</h1>
    <p>{t(lang, 'faq.intro')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="faq-list">
      {items.map((it, i) => (
        <details class="faq-item reveal" style={`--d:${i * 60}ms`}>
          <summary>{t(lang, `${it.key}.q`)}</summary>
          <div class="faq-answer">
            <p>{t(lang, `${it.key}.a`)}</p>
            <a class="faq-more" href={localizePath(it.link, lang)}>{t(lang, 'faq.more')}</a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBanner lang={lang} />

<style>
  /* A plain navy hero band (no photo) for the FAQ intro */
  .page-hero--plain {
    background: radial-gradient(120% 120% at 85% 0%, #0a4f86 0%, var(--blue) 32%, var(--blue-deep) 100%);
  }
  .page-hero--plain .page-hero__scrim {
    background: none;
  }

  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: grid;
    gap: 14px;
  }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .faq-item[open] {
    border-color: transparent;
    box-shadow: var(--shadow);
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 26px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.08rem;
    line-height: 1.3;
    color: var(--blue-deep);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  /* Chevron that rotates when open */
  .faq-item summary::after {
    content: '';
    flex: none;
    width: 11px;
    height: 11px;
    border-right: 2.5px solid var(--gold);
    border-bottom: 2.5px solid var(--gold);
    transform: rotate(45deg);
    transition: transform 0.3s ease;
    margin-top: -4px;
  }
  .faq-item[open] summary::after {
    transform: rotate(-135deg);
    margin-top: 3px;
  }
  .faq-item summary:hover {
    color: var(--blue);
  }
  .faq-item summary:focus-visible {
    outline: 3px solid var(--gold-soft);
    outline-offset: 2px;
    border-radius: 10px;
  }
  .faq-answer {
    padding: 0 26px 24px;
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .faq-answer p {
    margin: 0;
  }
  .faq-more {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--blue);
  }
  .faq-more::after {
    content: ' \2192';
  }
  .faq-more:hover {
    color: var(--gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-item summary::after {
      transition: none;
    }
  }
</style>
