---
import { t, localizePath, type Lang } from '../i18n/ui';
import QuoteBand from './QuoteBand.astro';
import MeetBert from './MeetBert.astro';
import StatsBand from './StatsBand.astro';
import Pathway from './Pathway.astro';
import AnalyticSoccer from './AnalyticSoccer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const contact = localizePath('/contact', lang);
const plan = localizePath('/the-mfh-plan', lang);
const services = localizePath('/services', lang);
const questionnaire = localizePath('/questionnaire', lang);

const strip = ['strip.1', 'strip.2', 'strip.3', 'strip.4', 'strip.5', 'strip.6'];
const problems = ['p1', 'p2', 'p3', 'p4'];
const who = ['w1', 'w2', 'w3'];
---

<!-- HERO (Modern Sport) -->
<section class="hero" data-hero>
  <img class="hero__bg" src="/videos/hero-still.jpg" alt="" width="1920" height="1080" fetchpriority="high" />
  <video
    class="hero__video"
    data-hero-video
    muted
    loop
    playsinline
    preload="none"
    poster="/videos/hero-still.jpg"
    aria-hidden="true"
  ></video>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner">
    <span class="eyebrow hero-in" style="--i:0"><i class="pent"></i><span>{t(lang, 'hero.eyebrow')}</span></span>
    <h1 class="hero__title hero-in" style="--i:1" set:html={t(lang, 'hero.h1')} />
    <p class="hero__sub hero-in" style="--i:2">{t(lang, 'hero.sub')}</p>
    <div class="actions hero-in" style="--i:3">
      <a href={questionnaire} class="btn btn-primary">{t(lang, 'cta.questionnaire')}</a>
      <a href={plan} class="btn btn-ghost">{t(lang, 'hero.cta2')}</a>
    </div>
    <div class="hero__creds hero-in" style="--i:4">
      <span>{t(lang, 'strip.1')}</span>
      <span>{t(lang, 'strip.2')}</span>
      <span>{t(lang, 'strip.3')}</span>
      <span>{t(lang, 'strip.4')}</span>
    </div>
  </div>
</section>

<!-- THE LANDSCAPE -->
<section class="section" id="landscape">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'problem.eyebrow')}</span></span>
      <h2>{t(lang, 'problem.h2')}</h2>
      <p class="lead">{t(lang, 'problem.intro')}</p>
    </div>
    <div class="grid g4">
      {problems.map((k, i) => (
        <div class="card reveal" style={`--d:${i * 90}ms`}><i class="pent"></i><h3>{t(lang, `${k}.t`)}</h3><p>{t(lang, `${k}.d`)}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- MEET BERT -->
<MeetBert lang={lang} />

<!-- STATS BAND -->
<StatsBand lang={lang} />

<!-- HOW WE WORK TOGETHER (five step cards + circular ecosystem) -->
<Pathway lang={lang} />

<!-- ANALYTIC SOCCER (evaluation partner) -->
<AnalyticSoccer lang={lang} />

<!-- PROMISE (bold band) -->
<QuoteBand
  lang={lang}
  img="/photos/promise-bg2.jpg"
  altKey="media.altPromise"
  smallKey="quote.promiseSmall"
  bigKey="quote.promiseBig"
/>

<!-- BRIDGE -->
<section class="section sky" id="bridge">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'bridge.eyebrow')}</span></span>
      <h2>{t(lang, 'bridge.h2')}</h2>
      <p class="lead">{t(lang, 'bridge.body')}</p>
    </div>
    <div class="bridge-row bridge-row--3">
      <div class="bridge-card reveal-l">
        <div class="media-slot" style="aspect-ratio:16/10;margin-bottom:18px"><img src="/photos/home-europe.jpg" alt={t(lang, 'media.altEurope')} width="1000" height="667" loading="lazy" /></div>
        <h3>{t(lang, 'bridge.euro')}</h3><p>{t(lang, 'bridge.eurod')}</p>
      </div>
      <div class="bridge-mid"><span class="bridge-line"></span><i class="pent"></i><span class="bridge-line"></span></div>
      <div class="bridge-card reveal">
        <div class="media-slot" style="aspect-ratio:16/10;margin-bottom:18px"><img src="/photos/home-usa.jpg" alt={t(lang, 'media.altSF')} width="1000" height="667" loading="lazy" /></div>
        <h3>{t(lang, 'bridge.left')}</h3><p>{t(lang, 'bridge.leftd')}</p>
      </div>
      <div class="bridge-mid"><span class="bridge-line"></span><i class="pent"></i><span class="bridge-line"></span></div>
      <div class="bridge-card reveal-r">
        <div class="media-slot" style="aspect-ratio:16/10;margin-bottom:18px"><img src="/photos/home-colombia.jpg" alt={t(lang, 'media.altColombia')} width="1000" height="667" loading="lazy" /></div>
        <h3>{t(lang, 'bridge.right')}</h3><p>{t(lang, 'bridge.rightd')}</p>
      </div>
    </div>
  </div>
</section>

<!-- WHO WE WORK WITH -->
<section class="section" id="who">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'who.eyebrow')}</span></span>
      <h2>{t(lang, 'who.h2')}</h2>
    </div>
    <div class="grid g3">
      {who.map((k, i) => (
        <div class="card reveal" style={`--d:${i * 90}ms`}><i class="pent"></i><h3>{t(lang, `${k}.t`)}</h3><p>{t(lang, `${k}.d`)}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- PARALLAX QUOTE BAND -->
<QuoteBand lang={lang} img="/photos/home-quote.jpg" />

<!-- SERVICES PREVIEW -->
<section class="section sky" id="services">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'services.eyebrow')}</span></span>
      <h2>{t(lang, 'services.h2')}</h2>
      <p class="lead">{t(lang, 'services.intro')}</p>
    </div>
    <div class="svc">
      <div class="card reveal" style="--d:0ms"><i class="pent"></i><h3>{t(lang, 'b1.t')}</h3><p class="items">{t(lang, 'b1.i')}</p></div>
      <div class="card reveal" style="--d:90ms"><i class="pent"></i><h3>{t(lang, 'b2.t')}</h3><p class="items">{t(lang, 'b2.i')}</p></div>
      <div class="card reveal" style="--d:180ms"><i class="pent"></i><h3>{t(lang, 'b3.t')}</h3><p class="items">{t(lang, 'b3.i')}</p></div>
    </div>
    <div style="margin-top:30px" class="reveal"><a href={services} class="btn btn-outline">{t(lang, 'services.cta')}</a></div>
  </div>
</section>

<!-- CTA BANNER -->
<section class="cta-banner" id="contact">
  <div class="wrap">
    <div>
      <h2>{t(lang, 'cta.h2')}</h2>
      <p>{t(lang, 'cta.sub')}</p>
    </div>
    <div class="cta-banner__actions">
      <a href={questionnaire} class="btn btn-primary">{t(lang, 'cta.questionnaire')}</a>
      <a href={contact} class="btn btn-ghost">{t(lang, 'cta.consult')}</a>
    </div>
  </div>
</section>

<script>
  // Hero ambient video: plays on phones and desktop alike. Phones get a lighter
  // 720p file so they stay fast. Skipped only when the visitor asks for reduced
  // motion or is on a data-saver / 2g connection, in which case the still stays.
  const video = document.querySelector('[data-hero-video]') as HTMLVideoElement | null;
  if (video) {
    const motionOk = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conn = (navigator as any).connection;
    const cheapData = conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''));
    if (motionOk && !cheapData) {
      const small = matchMedia('(max-width: 767px)').matches;
      const source = document.createElement('source');
      source.src = small ? '/videos/hero-ambient-mobile.mp4' : '/videos/hero-ambient.mp4';
      source.type = 'video/mp4';
      video.appendChild(source);
      video.load();
      const play = () => video.play().catch(() => {});
      video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
      if (video.readyState >= 3) play();
      else video.addEventListener('canplay', play, { once: true });
    }
  }
</script>
