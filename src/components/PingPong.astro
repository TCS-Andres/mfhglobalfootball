---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  eyebrowKey: string;
  headingKey: string;
  leadKey?: string;
  items: { title: string; body: string; img: string }[];
  tone?: 'sky' | 'plain';
}
const { lang, eyebrowKey, headingKey, leadKey, items, tone = 'sky' } = Astro.props;
---

<section class:list={['section', tone === 'sky' && 'sky']}>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, eyebrowKey)}</span></span>
      <h2>{t(lang, headingKey)}</h2>
      {leadKey && <p class="lead">{t(lang, leadKey)}</p>}
    </div>
    <div class="pp">
      {items.map((it, i) => (
        <div class="pp__row" class:list={[{ 'pp__row--rev': i % 2 === 1 }]}>
          <div class="pp__media reveal-scale">
            <img src={it.img} alt="" width="900" height="620" loading="lazy" />
          </div>
          <div class="pp__text reveal">
            <span class="pp__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t(lang, it.title)}</h3>
            <p>{t(lang, it.body)}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pp {
    display: grid;
    gap: clamp(44px, 6vw, 76px);
    margin-top: 8px;
  }
  .pp__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 60px);
    align-items: center;
  }
  .pp__media {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 16 / 11;
  }
  .pp__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pp__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    color: var(--gold);
  }
  .pp__text h3 {
    margin-top: 10px;
    font-size: clamp(1.4rem, 2.4vw, 1.95rem);
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1.08;
  }
  .pp__text h3::after {
    content: '';
    display: block;
    width: 48px;
    height: 4px;
    border-radius: 2px;
    background: var(--gold);
    margin-top: 16px;
  }
  .pp__text p {
    margin-top: 18px;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.72;
  }
  /* Alternate: image moves to the right on odd rows */
  .pp__row--rev .pp__media {
    order: 2;
  }
  @media (max-width: 820px) {
    .pp__row,
    .pp__row--rev {
      grid-template-columns: 1fr;
    }
    .pp__row--rev .pp__media {
      order: 0;
    }
    .pp__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
