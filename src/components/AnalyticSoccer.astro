---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  tone?: 'plain' | 'sky';
}
const { lang, tone = 'sky' } = Astro.props;

// Analytic Soccer partner block: clickable logo + short blurb + points + CTA,
// all linking out to analyticsoccer.com (new tab). Regular link for now; swap
// to an affiliate link once Bert supplies the tracking details.
const link = 'https://analyticsoccer.com/';
---

<section class:list={['section', { sky: tone === 'sky' }]} id="analytic-soccer">
  <div class="wrap">
    <div class="partner">
      <a class="partner__logo" href={link} target="_blank" rel="noopener noreferrer" aria-label="Analytic Soccer, opens in a new tab">
        <img src="/photos/analytic-soccer.webp" alt="Analytic Soccer" width="1080" height="764" loading="lazy" />
      </a>
      <div class="partner__body reveal-r">
        <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'as.eyebrow')}</span></span>
        <h2>{t(lang, 'as.title')}</h2>
        <p>{t(lang, 'as.body')}</p>
        <ul class="partner__points">
          <li><i class="pent"></i><span>{t(lang, 'as.b1')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'as.b2')}</span></li>
          <li><i class="pent"></i><span>{t(lang, 'as.b3')}</span></li>
        </ul>
        <a class="btn btn-primary" href={link} target="_blank" rel="noopener noreferrer">{t(lang, 'as.cta')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .partner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  .partner__logo {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: clamp(24px, 4vw, 40px);
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .partner__logo:hover,
  .partner__logo:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(12, 27, 41, 0.16);
  }
  .partner__logo img {
    width: 100%;
    height: auto;
    display: block;
  }
  .partner__body h2 {
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1.08;
    font-size: clamp(1.55rem, 2.8vw, 2.15rem);
    margin-top: 14px;
  }
  .partner__body > p {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 1.04rem;
  }
  .partner__points {
    list-style: none;
    margin: 20px 0 26px;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .partner__points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-weight: 600;
    color: var(--ink);
  }
  .partner__points .pent {
    margin-top: 5px;
    flex: none;
  }
  @media (max-width: 860px) {
    .partner {
      grid-template-columns: 1fr;
    }
    .partner__logo {
      max-width: 440px;
    }
  }
</style>
