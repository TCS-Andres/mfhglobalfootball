---
import { t, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="cta-banner">
  <div class="wrap">
    <div>
      <h2>{t(lang, 'cta.h2')}</h2>
      <p>{t(lang, 'cta.sub')}</p>
    </div>
    <div class="cta-banner__actions">
      <a href={localizePath('/questionnaire', lang)} class="btn btn-primary">{t(lang, 'cta.questionnaire')}</a>
      <a href={localizePath('/contact', lang)} class="btn btn-ghost">{t(lang, 'cta.consult')}</a>
    </div>
  </div>
</section>
