---
import { t, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Each ecosystem step links to its next action. Player Profile + Evaluation both
// point to the Analytic Soccer platform (analyticsoccer.com). "Book Agent Call"
// opens the consultation booking (Calendly). Opportunity has no link. External
// links open in a new tab. The booking URL mirrors the contact page's env var.
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || 'https://calendly.com/mfhglobal-football';
const analyticSoccer = 'https://analyticsoccer.com/';
const links: Record<number, { href: string; external: boolean; cta?: string }> = {
  1: { href: localizePath('/questionnaire', lang), external: false },
  2: { href: analyticSoccer, external: true, cta: 'pw.s2.cta' },
  3: { href: analyticSoccer, external: true, cta: 'pw.s3.cta' },
  4: { href: bookingUrl, external: true },
  5: { href: '', external: false },
};

// The MFH Global Football Agency Pathway: one continuous circular ecosystem.
// Center hub carries the heading + body; five gold pentagon nodes ring it, each
// linked to the hub by a thin spoke, with gold flow-arcs showing the clockwise
// 1 to 5 process. Distinct from "How It Works" (the action list). No third party
// company is named (brand rule 0.8). Circular on desktop, vertical list below.

const stages = [1, 2, 3, 4, 5];

// SVG geometry (viewBox 0..100). Kept in sync with the CSS node positions below.
const R = 39; // ring radius (pentagon centers)
const HUB = 22; // hub circle radius
const cx = 50;
const cy = 50;
const pt = (deg: number, r: number): [number, number] => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const nodes = stages.map((n, i) => {
  const deg = i * 72;
  const [x, y] = pt(deg, R);
  return { n, deg, x, y };
});
const spokes = nodes.map((nd) => {
  const [x1, y1] = pt(nd.deg, HUB + 1.5);
  const [x2, y2] = pt(nd.deg, R - 5.5);
  return { x1, y1, x2, y2 };
});
const gap = 17; // degree gap so arcs clear the pentagons and their labels
const arcs = nodes.map((nd) => {
  const s = nd.deg + gap;
  const e = nd.deg + 72 - gap;
  const [x1, y1] = pt(s, R);
  const [x2, y2] = pt(e, R);
  // arrowhead sits at the arc midpoint (the open gap between two nodes), not on
  // top of a node's label, and points clockwise.
  const mid = nd.deg + 36;
  const [mx, my] = pt(mid, R);
  const a = ((mid - 90) * Math.PI) / 180;
  const rot = (Math.atan2(Math.cos(a), -Math.sin(a)) * 180) / Math.PI;
  return { d: `M ${x1} ${y1} A ${R} ${R} 0 0 1 ${x2} ${y2}`, hx: mx, hy: my, rot };
});
---

<section class="section pathway">
  <div class="wrap">
    <div class="pathway__ring">
      <svg class="pathway__svg" viewBox="0 0 100 100" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="pw-hub" cx="50%" cy="42%" r="60%">
            <stop offset="0%" stop-color="var(--sky)" />
            <stop offset="100%" stop-color="var(--paper)" />
          </radialGradient>
        </defs>
        {spokes.map((s) => (
          <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--blue)" stroke-opacity="0.14" stroke-width="0.4" />
        ))}
        {arcs.map((arc) => (
          <>
            <path d={arc.d} fill="none" stroke="var(--gold)" stroke-opacity="0.55" stroke-width="0.7" stroke-linecap="round" />
            <path d="M -1.6 -1.25 L 1.3 0 L -1.6 1.25 Z" fill="var(--gold)" transform={`translate(${arc.hx} ${arc.hy}) rotate(${arc.rot})`} />
          </>
        ))}
        <circle cx={cx} cy={cy} r={HUB} fill="url(#pw-hub)" stroke="var(--blue)" stroke-opacity="0.16" stroke-width="0.5" />
      </svg>

      <div class="pathway__hub">
        <h2 class="pathway__title">{t(lang, 'pw.title')}</h2>
        <p class="pathway__sub">{t(lang, 'pw.sub')}</p>
      </div>

      <ol class="pathway__list">
        {stages.map((n, i) => {
          const link = links[n];
          const linked = Boolean(link && link.href);
          return (
            <li class:list={['pathway__step', `pathway__step--${n}`, 'reveal', { 'pathway__step--link': linked }]} style={`--d:${i * 80}ms`}>
              <span class="pathway__badge" aria-hidden="true">{n}</span>
              <div class="pathway__label">
                <h3 class="pathway__name">{t(lang, `pw.s${n}.n`)}</h3>
                <p class="pathway__copy">{t(lang, `pw.s${n}.d`)}</p>
                {link && link.cta && <span class="pathway__cta">{t(lang, link.cta)}</span>}
              </div>
              {linked && (
                <a
                  class="pathway__stretch"
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  aria-label={t(lang, `pw.s${n}.n`)}
                ></a>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .pathway {
    background: var(--paper);
  }

  /* ---------- Circular ecosystem (desktop, >= 880px) ---------- */
  @media (min-width: 880px) {
    .pathway__ring {
      position: relative;
      width: min(100%, 860px);
      margin: 0 auto;
      aspect-ratio: 1 / 1;
    }
    .pathway__svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    .pathway__hub {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(40%, 330px);
      text-align: center;
      z-index: 2;
    }
    .pathway__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .pathway__step {
      position: absolute;
      width: 176px;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      z-index: 1;
    }
    /* pentagon centers on the ring (r = 39%); labels sit just below each node */
    .pathway__step--1 { top: 11%; left: 50%; }
    .pathway__step--2 { top: 38%; left: 87.1%; }
    .pathway__step--3 { top: 81.6%; left: 72.9%; }
    .pathway__step--4 { top: 81.6%; left: 27.1%; }
    .pathway__step--5 { top: 38%; left: 12.9%; }
    .pathway__badge {
      margin-bottom: 12px;
    }
  }

  /* Shared styling */
  .pathway__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.45rem, 2.3vw, 2rem);
    color: var(--blue);
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
    line-height: 1.12;
  }
  .pathway__sub {
    font-family: var(--font-body);
    color: var(--ink-soft);
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .pathway__badge {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    flex: none;
    background: var(--gold);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.32rem;
    clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
    box-shadow: 0 6px 16px rgba(201, 162, 39, 0.28);
  }
  .pathway__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--blue);
    margin: 0 0 0.3rem;
    letter-spacing: 0.01em;
  }
  .pathway__copy {
    font-family: var(--font-body);
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--ink-soft);
    margin: 0;
  }
  /* Clickable steps: whole card links via a stretched anchor */
  .pathway__cta {
    display: inline-block;
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    color: var(--blue);
  }
  .pathway__cta::after {
    content: ' \203A';
    font-weight: 800;
  }
  .pathway__step--link {
    cursor: pointer;
  }
  .pathway__badge {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pathway__stretch {
    position: absolute;
    inset: -8px;
    z-index: 3;
    border-radius: 14px;
  }
  .pathway__step--link:hover .pathway__name,
  .pathway__step--link:focus-within .pathway__name {
    color: var(--blue-deep);
  }
  .pathway__step--link:hover .pathway__cta,
  .pathway__step--link:focus-within .pathway__cta {
    text-decoration: underline;
  }
  .pathway__step--link:hover .pathway__badge,
  .pathway__step--link:focus-within .pathway__badge {
    transform: scale(1.06);
  }
  .pathway__stretch:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  /* ---------- Vertical layout (< 880px) ---------- */
  @media (max-width: 879px) {
    .pathway__ring {
      max-width: 620px;
      margin: 0 auto;
    }
    .pathway__svg {
      display: none;
    }
    .pathway__hub {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .pathway__title {
      font-size: clamp(1.75rem, 5vw, 2.3rem);
    }
    .pathway__sub {
      max-width: 46ch;
      margin: 0 auto;
      font-size: 1.02rem;
    }
    .pathway__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.5rem;
    }
    .pathway__step {
      position: relative;
      display: grid;
      grid-template-columns: 58px 1fr;
      column-gap: 1rem;
      align-items: start;
      text-align: left;
    }
    .pathway__name {
      margin-top: 4px;
      font-size: 1.08rem;
    }
    .pathway__copy {
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pathway__step {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
