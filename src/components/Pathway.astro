---
import { t, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// "How We Work Together": one section. Five step CARDS carry the copy and the
// calls to action; below them the same five steps are drawn as a circular
// ecosystem (headings only, the fancier visual). Player Profile + Evaluation
// link to Analytic Soccer, Book A Call opens the Calendly booking, the
// Questionnaire card opens the intake form, Opportunity has no action.
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || 'https://calendly.com/mfhglobal-football';
const analyticSoccer = 'https://analyticsoccer.com/';
const stages = [1, 2, 3, 4, 5];
const cardCta: Record<number, { key: string; href: string; external: boolean }> = {
  1: { key: 'pw.s1.cta', href: localizePath('/questionnaire', lang), external: false },
  2: { key: 'pw.s2.cta', href: analyticSoccer, external: true },
  3: { key: 'pw.s3.cta', href: analyticSoccer, external: true },
  4: { key: 'pw.s4.cta', href: bookingUrl, external: true },
  5: { key: 'pw.s5.cta', href: localizePath('/questionnaire', lang), external: false },
};

// Circular ecosystem geometry (viewBox 0..100), kept in sync with the CSS positions.
const R = 39;
const HUB = 22;
const cx = 50;
const cy = 50;
const pt = (deg: number, r: number): [number, number] => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
};
const nodes = stages.map((n, i) => {
  const deg = i * 72;
  const [x, y] = pt(deg, R);
  return { n, deg, x, y };
});
const spokes = nodes.map((nd) => {
  const [x1, y1] = pt(nd.deg, HUB + 1.5);
  const [x2, y2] = pt(nd.deg, R - 5.5);
  return { x1, y1, x2, y2 };
});
const gap = 17;
const arcs = nodes.map((nd) => {
  const s = nd.deg + gap;
  const e = nd.deg + 72 - gap;
  const [x1, y1] = pt(s, R);
  const [x2, y2] = pt(e, R);
  const mid = nd.deg + 36;
  const [mx, my] = pt(mid, R);
  const a = ((mid - 90) * Math.PI) / 180;
  const rot = (Math.atan2(Math.cos(a), -Math.sin(a)) * 180) / Math.PI;
  return { d: `M ${x1} ${y1} A ${R} ${R} 0 0 1 ${x2} ${y2}`, hx: mx, hy: my, rot };
});
---

<section class="section pathway">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow"><i class="pent"></i><span>{t(lang, 'plan.eyebrow')}</span></span>
      <h2>{t(lang, 'pw.headline')}</h2>
    </div>

    <!-- Five step cards (the copy + the actions) -->
    <ol class="pw-cards">
      {stages.map((n, i) => {
        const c = cardCta[n];
        return (
          <li class="pw-card reveal" style={`--d:${i * 70}ms`}>
            <span class="pw-card__num" aria-hidden="true">{n}</span>
            <h3 class="pw-card__name">{t(lang, `pw.s${n}.n`)}</h3>
            <p class="pw-card__copy">{t(lang, `pw.s${n}.d`)}</p>
            {c && (
              <a
                class="pw-card__cta"
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
              >
                {t(lang, c.key)}
              </a>
            )}
          </li>
        );
      })}
    </ol>

    <!-- The same five steps as a circular ecosystem (decorative, headings only) -->
    <div class="pathway__ring reveal" aria-hidden="true">
      <svg class="pathway__svg" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="pw-hub" cx="50%" cy="42%" r="60%">
            <stop offset="0%" stop-color="var(--sky)" />
            <stop offset="100%" stop-color="var(--paper)" />
          </radialGradient>
        </defs>
        {spokes.map((s) => (
          <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke="var(--blue)" stroke-opacity="0.14" stroke-width="0.4" />
        ))}
        {arcs.map((arc) => (
          <>
            <path d={arc.d} fill="none" stroke="var(--gold)" stroke-opacity="0.55" stroke-width="0.7" stroke-linecap="round" />
            <path d="M -1.6 -1.25 L 1.3 0 L -1.6 1.25 Z" fill="var(--gold)" transform={`translate(${arc.hx} ${arc.hy}) rotate(${arc.rot})`} />
          </>
        ))}
        <circle cx={cx} cy={cy} r={HUB} fill="url(#pw-hub)" stroke="var(--blue)" stroke-opacity="0.16" stroke-width="0.5" />
      </svg>

      <div class="pathway__hub">
        <h3 class="pathway__title">{t(lang, 'pw.hub')}</h3>
        <p class="pathway__sub">{t(lang, 'pw.sub')}</p>
      </div>

      <ol class="pathway__list">
        {stages.map((n) => (
          <li class={`pathway__step pathway__step--${n}`}>
            <span class="pathway__badge">{n}</span>
            <span class="pathway__name">{t(lang, `pw.s${n}.n`)}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .pathway {
    background: var(--paper);
  }

  /* ---------- Cards ---------- */
  .pw-cards {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }
  .pw-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 28px 22px;
    overflow: hidden;
  }
  .pw-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--gold);
  }
  .pw-card__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.2rem;
    line-height: 1;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .pw-card__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.08rem;
    color: var(--ink);
    margin: 0 0 8px;
    letter-spacing: -0.005em;
  }
  .pw-card__copy {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0;
    flex: 1 1 auto;
  }
  .pw-card__cta {
    margin-top: 18px;
    align-self: flex-start;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--blue);
  }
  .pw-card__cta::after {
    content: ' \203A';
    font-weight: 800;
  }
  .pw-card__cta:hover,
  .pw-card__cta:focus-visible {
    color: var(--blue-deep);
    text-decoration: underline;
  }
  @media (max-width: 1024px) {
    .pw-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 680px) {
    .pw-cards {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Circular ecosystem (desktop only, decorative) ---------- */
  .pathway__ring {
    display: none;
  }
  @media (min-width: 900px) {
    .pathway__ring {
      display: block;
      position: relative;
      width: min(100%, 820px);
      margin: 3.5rem auto 0;
      aspect-ratio: 1 / 1;
    }
    .pathway__svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    .pathway__hub {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(42%, 340px);
      text-align: center;
      z-index: 2;
    }
    .pathway__title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(1.6rem, 2.6vw, 2.15rem);
      color: var(--blue);
      margin: 0 0 0.6rem;
      letter-spacing: -0.01em;
      line-height: 1.1;
    }
    .pathway__sub {
      font-family: var(--font-body);
      color: var(--ink-soft);
      margin: 0;
      font-size: 0.92rem;
      line-height: 1.5;
    }
    .pathway__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .pathway__step {
      position: absolute;
      width: 168px;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .pathway__step--1 { top: 10%; left: 50%; }
    .pathway__step--2 { top: 37%; left: 88%; }
    .pathway__step--3 { top: 82%; left: 73%; }
    .pathway__step--4 { top: 82%; left: 27%; }
    .pathway__step--5 { top: 37%; left: 12%; }
    .pathway__badge {
      display: grid;
      place-items: center;
      width: 60px;
      height: 60px;
      margin-bottom: 12px;
      background: var(--gold);
      color: #fff;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.36rem;
      clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
      box-shadow: 0 6px 16px rgba(201, 162, 39, 0.28);
    }
    .pathway__name {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.18rem;
      color: var(--blue);
      letter-spacing: -0.005em;
      line-height: 1.15;
    }
  }
</style>
