---
import { t, localizePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Official profiles, provided by the client (July 2026). No YouTube channel yet.
const social = {
  instagram: 'https://www.instagram.com/mfhglobalfootball/',
  linkedin: 'https://www.linkedin.com/company/mfh-global-football',
};
---

<footer class="site">
  <div class="wrap">
    <div class="top">
      <div>
        <img class="flogo" src="/logos/footer.png" alt="MFH Global Football" width="184" height="64" />
        <p class="tag">{t(lang, 'footer.tagline')}</p>
        <p class="verse">{t(lang, 'footer.verse')}</p>
      </div>
      <div>
        <h4>{t(lang, 'footer.col1')}</h4>
        <ul>
          <li><a href={localizePath('/services', lang)}>{t(lang, 'nav.services')}</a></li>
          <li><a href={localizePath('/about', lang)}>{t(lang, 'nav.about')}</a></li>
          <li><a href={localizePath('/bert-mahecha', lang)}>{t(lang, 'nav.journey')}</a></li>
          <li><a href={localizePath('/team', lang)}>{t(lang, 'nav.staff')}</a></li>
          <li><a href={localizePath('/the-mfh-plan', lang)}>{t(lang, 'nav.plan')}</a></li>
          <li><a href={localizePath('/faq', lang)}>{t(lang, 'nav.faq')}</a></li>
          <li><a href={localizePath('/contact', lang)}>{t(lang, 'nav.contact')}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t(lang, 'footer.col2')}</h4>
        <ul>
          <li><a href={localizePath('/contact', lang)}>{t(lang, 'cta.consult')}</a></li>
          <li>{t(lang, 'footer.contactLine')}</li>
        </ul>
        <div class="social" aria-label="Social media">
          <a href={social.instagram} aria-label="Instagram" rel="me noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
              <circle cx="12" cy="12" r="4.5" />
              <circle cx="17.6" cy="6.4" r="1.5" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a href={social.linkedin} aria-label="LinkedIn" rel="me noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.98 3.5C4.98 4.88 3.87 6 2.49 6 1.11 6 0 4.88 0 3.5 0 2.12 1.11 1 2.49 1c1.38 0 2.49 1.12 2.49 2.5zM.4 8.2h4.18V23H.4V8.2zm7.1 0h4v2.02h.06c.56-1.06 1.93-2.18 3.97-2.18 4.24 0 5.02 2.8 5.02 6.43V23h-4.17v-7.36c0-1.76-.03-4.02-2.45-4.02-2.45 0-2.83 1.91-2.83 3.89V23H7.5V8.2z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div class="bottom">
      <span>{t(lang, 'footer.rights')}</span>
      <span>{t(lang, 'footer.domain')}</span>
    </div>
  </div>
</footer>
